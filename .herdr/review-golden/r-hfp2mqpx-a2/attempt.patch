+/// What pays for a successor session.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize, schemars::JsonSchema)]
+#[serde(rename_all = "snake_case")]
+pub enum CoordinatorFunding {
+    /// The agent's own login.
+    Login,
+    /// The Anthropic API credits, through herdr's credit proxy (Claude Code).
+    Credits,
+    /// A value a newer server sent that this client does not know.
+    #[serde(other)]
+    Unknown,
+}
+
+impl CoordinatorFunding {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Self::Login => "login",
+            Self::Credits => "credits",
+            Self::Unknown => "unknown",
+        }
+    }
