+/// Dropping a listener that is serving a request returns at once: the
+/// serving thread ends itself when that request is done, and says so
+/// through its [`Termination`]. A drop that joined the thread would never
+/// return here, because the upstream is held until after the drop.
+#[test]
+fn dropping_a_busy_loopback_listener_does_not_wait_for_its_request() {
+    use std::sync::mpsc;
+    static STARTED: Mutex<Option<mpsc::Sender<()>>> = Mutex::new(None);
+    static RELEASE: Mutex<Option<mpsc::Receiver<()>>> = Mutex::new(None);
+    let (started_tx, started_rx) = mpsc::channel();
+    let (release_tx, release_rx) = mpsc::channel();
+    *STARTED.lock().unwrap() = Some(started_tx);
+    *RELEASE.lock().unwrap() = Some(release_rx);
+    let f = Fixture::new(200.0);
+    let ledger = f.dir.join("busy.sqlite");
+    let config = crate::config::WorkersConfig {
+        anthropic_api_key_file: f.dir.join("key").display().to_string(),
+        ..Default::default()
+    };
+    let proxy = AnthropicProxy::open(&config, &ledger).unwrap();
+    let listener =
+        LoopbackProxy::start_with(proxy, ledger.clone(), "busy", "coordinator", |_, _, out| {
+            let started = STARTED.lock().unwrap().take().unwrap();
+            started.send(()).unwrap();
+            let release = RELEASE.lock().unwrap().take().unwrap();
+            release.recv().unwrap();
+            out.write_all(&Fixture::response())
+        })
+        .unwrap();
+    let terminated = listener.termination();
+    let mut client = std::net::TcpStream::connect(("127.0.0.1", listener.port)).unwrap();
+    client
+        .write_all(&Fixture::request(&listener.token, false))
+        .unwrap();
+    started_rx.recv().unwrap();
+    drop(listener);
+    assert!(!terminated.is_done(), "the request is still being served");
+    release_tx.send(()).unwrap();
+    terminated.wait();
+    let mut answer = String::new();
+    client.read_to_string(&mut answer).unwrap();
+    assert!(answer.starts_with("HTTP/1.1 200"), "{answer}");
+    // The request in flight was accounted, not left pending.
+    let (cost, pending) = AnthropicProxy::accounting(&ledger, Some("busy")).unwrap();
+    assert!(cost > 0.0);
+    assert_eq!(pending, 0);
+}
