+        ] {
+            assert_eq!(get(name), Some("claude-sonnet-5-5"), "{name}");
+        }
+        assert_eq!(get("ANTHROPIC_API_KEY"), None);
+        assert_eq!(get("ANTHROPIC_SMALL_FAST_MODEL"), None);
+        assert!(env.iter().all(|(_, value)| !value.starts_with("sk-ant-")));
+        assert!(!format!("{grant:?}").contains("grant-token"));
+    }
+
+    #[test]
+    fn a_credit_handoff_binds_the_grant_to_the_tenure_and_writes_no_secret_anywhere() {
+        let f = Fixture::new("grant");
+        let tenure = f.frozen();
+        let prepared = f.credits("claude", &f.setup).unwrap();
+        let grant = prepared.credit.clone().expect("a credit grant");
+        assert_eq!(grant.model, f.setup.config.anthropic_api_model);
+        assert_eq!(f.listeners(), 1);
+        {
+            // The ledger run is the tenure and epoch; the stage `coordinator`
+            // is the ledger item.
+            let started = f.started.lock().unwrap();
+            assert_eq!(started.len(), 1);
+            assert_eq!(
+                (started[0].0.as_str(), started[0].1.as_str()),
+                (
+                    format!("{}-e{}", tenure.coordinator_id, tenure.epoch).as_str(),
+                    "coordinator"
+                )
+            );
+        }
+        assert!(!format!("{prepared:?}").contains(&grant.token));
+        f.supervisor
+            .handoff_successor_started(&prepared.coordinator_id, "p2")
+            .unwrap();
+
+        // Everything herdr writes or reports: manifest, snapshot, state
+        // file and the status JSON.
+        let handoffs = f.root.join("workers/handoffs");
+        let mut texts = Vec::new();
+        for entry in std::fs::read_dir(&handoffs).unwrap() {
+            texts.push(std::fs::read_to_string(entry.unwrap().path()).unwrap_or_default());
+        }
+        texts.push(serde_json::to_string(&f.supervisor.coordinator_status(None).unwrap()).unwrap());
+        assert!(texts.len() >= 4, "manifest, snapshot, note copy and state");
+        let manifest = texts
+            .iter()
+            .find(|text| text.contains("\"funding\": \"credits\""))
+            .expect("the manifest records the funding");
+        assert!(manifest.contains("\"agent_kind\""));
+        for text in &texts {
+            for secret in [
+                KEY,
+                grant.token.as_str(),
+                grant.address.as_str(),
+                "ANTHROPIC_",
+            ] {
+                assert!(!text.contains(secret), "{secret} leaked");
+            }
+        }
+    }
+
+    #[test]
+    fn the_launcher_claims_the_armed_grant_once_and_only_from_its_pane() {
+        let f = Fixture::new("claim");
+        f.frozen();
+        let prepared = f.credits("claude", &f.setup).unwrap();
+        let grant = prepared.credit.clone().unwrap();
+        // Nothing is claimable before it is armed.
+        assert!(f.supervisor.credit_launch_claim("p2").is_err());
+        f.supervisor
+            .credit_launch_arm("p2", &prepared.coordinator_id, grant.clone());
+        assert!(f.supervisor.credit_launch_claim("p3").is_err());
+        assert_eq!(f.supervisor.credit_launch_claim("p2").unwrap(), grant);
+        let again = f.supervisor.credit_launch_claim("p2").unwrap_err();
+        assert!(again.to_string().contains("claimed already"), "{again}");
+        // A start that failed takes the armed launch back; an aborted
+        // handoff purges it with the listener.
+        f.supervisor
+            .credit_launch_arm("p2", &prepared.coordinator_id, grant.clone());
+        f.supervisor.credit_launch_disarm("p2");
+        assert!(f.supervisor.credit_launch_claim("p2").is_err());
+        f.supervisor
+            .credit_launch_arm("p2", &prepared.coordinator_id, grant);
+        f.supervisor.handoff_abort(&prepared.coordinator_id, "test");
+        assert!(f.supervisor.credit_launch_claim("p2").is_err());
+    }
+
+    #[test]
+    fn the_listener_serves_the_successor_tenure_and_its_grant_ends_with_it() {
+        let f = Fixture::new("tenure");
+        let (_, tenure) = f.acked();
+        let ended = Arc::clone(&f.started.lock().unwrap()[0].2);
+        assert!(!ended.is_done(), "still serving after the ack");
+        let status = status_of(&f);
+        assert_eq!(status.funding, Some(CoordinatorFunding::Credits));
+        assert_eq!(status.funding_note, None);
+        f.supervisor
+            .coordinator_end(&tenure.coordinator_id, "ended", None)
+            .unwrap();
+        assert_eq!(f.listeners(), 0);
+        ended.wait();
+        assert!(lock(&f.supervisor.shared.registry).credit_keys.is_empty());
+    }
+
+    #[test]
+    fn an_aborted_handoff_revokes_the_grant() {
+        let f = Fixture::new("abort");
+        f.frozen();
+        let prepared = f.credits("claude", &f.setup).unwrap();
+        let ended = Arc::clone(&f.started.lock().unwrap()[0].2);
+        f.supervisor
+            .handoff_successor_started(&prepared.coordinator_id, "p2")
+            .unwrap();
+        assert!(!ended.is_done());
+        f.supervisor.handoff_abort(&prepared.coordinator_id, "test");
+        assert_eq!(f.listeners(), 0);
+        ended.wait();
+        let tenure = f
+            .supervisor
+            .with_handoff(f.supervisor.coordinator_of_pane("p1").unwrap());
+        assert!(tenure.handoff.is_none());
+        assert_eq!(tenure.funding, Some(CoordinatorFunding::Login));
+        assert!(lock(&f.supervisor.shared.registry).credit_keys.is_empty());
+    }
+
+    #[test]
+    fn a_failed_manifest_write_revokes_the_grant_and_keeps_no_intent() {
+        let f = Fixture::new("write-fails");
+        let tenure = f.frozen();
+        // A directory where the snapshot goes makes its write fail.
+        let dir = f.supervisor.handoffs_dir().unwrap();
+        std::fs::create_dir(dir.join(format!(
+            "{}-e{}.snapshot.json",
+            tenure.coordinator_id, tenure.epoch
+        )))
+        .unwrap();
+        let error = f.credits("claude", &f.setup).unwrap_err();
+        assert!(!error.to_string().is_empty());
+        let ended = Arc::clone(&f.started.lock().unwrap()[0].2);
+        ended.wait();
+        assert_eq!(f.listeners(), 0);
+        assert!(lock(&f.supervisor.shared.registry).credit_keys.is_empty());
+    }
+
+    /// The listener lives in the server's memory; the intent is persisted.
+    /// After a restart or a live handoff the session still holds the dead
+    /// address: it is reported as credits with its endpoint unavailable,
+    /// never as the login.
+    #[test]
+    fn after_a_restart_the_tenure_reports_credits_unavailable_not_login() {
+        let mut f = Fixture::new("restart");
+        let (_, tenure) = f.acked();
+        f.reopen();
+        assert_eq!(f.listeners(), 0);
+        let status = status_of(&f);
+        assert_eq!(status.coordinator_id, tenure.coordinator_id);
+        assert_eq!(status.funding, Some(CoordinatorFunding::Credits));
+        let note = status.funding_note.expect("an actionable note");
+        assert!(
+            note.contains("--funding credits") && note.contains("login"),
+            "{note}"
+        );
+        // The unavailable state also survives a second restart, and ending
+        // the tenure clears the intent.
+        f.reopen();
+        assert_eq!(status_of(&f).funding, Some(CoordinatorFunding::Credits));
+        f.supervisor
+            .coordinator_end(&tenure.coordinator_id, "ended", None)
+            .unwrap();
+        assert!(lock(&f.supervisor.shared.registry).credit_keys.is_empty());
+    }
+
+    #[test]
+    fn a_pending_credit_handoff_is_reported_unavailable_after_a_restart() {
+        let mut f = Fixture::new("restart-pending");
+        f.frozen();
+        let prepared = f.credits("claude", &f.setup).unwrap();
+        f.supervisor
+            .handoff_successor_started(&prepared.coordinator_id, "p2")
+            .unwrap();
+        f.reopen();
+        let old = f.supervisor.coordinator_of_pane("p1").unwrap();
+        let info = f.supervisor.with_handoff(old);
+        // A successor whose agent is not detected yet keeps the handoff
+        // pending across the restart.
+        let handoff = info.handoff.expect("the handoff is still pending");
+        assert_eq!(handoff.funding, Some(CoordinatorFunding::Credits));
+        assert!(info.funding_note.is_some());
+    }
+
+    #[test]
+    fn every_refusal_comes_before_anything_starts_and_names_why() {
+        let f = Fixture::new("refusals");
+        f.frozen();
+        let refused = |result: Result<Prepared, WorkerError>, needle: &str| {
+            let error = result.expect_err("expected a refusal");
+            assert_eq!(error.code(), "handoff_refused");
+            assert!(error.to_string().contains(needle), "{error}");
+            assert_eq!(f.listeners(), 0);
+            assert!(lock(&f.supervisor.shared.registry).credit_keys.is_empty());
+            // Nothing was written: no manifest.
+            let dir = f.supervisor.handoffs_dir().unwrap();
+            assert!(
+                std::fs::read_dir(dir).unwrap().all(|entry| !entry
+                    .unwrap()
+                    .file_name()
+                    .to_string_lossy()
+                    .contains("manifest")),
+                "{needle}: a manifest was written"
+            );
+        };
+        // pi: not in this slice.
+        refused(f.credits("pi", &f.setup), "claude only");
+        // No credit configuration at all.
+        refused(
+            f.supervisor
+                .handoff_prepare_funded("p1", "claude", CoordinatorFunding::Credits, None),
+            "no credit configuration",
+        );
+        refused(
+            f.supervisor
+                .handoff_prepare_funded("p1", "claude", CoordinatorFunding::Unknown, None),
+            "unknown funding",
+        );
+        // No credit model configured, or one without a tariff.
+        let mut setup = f.setup.clone();
+        setup.config.anthropic_api_model = String::new();
+        refused(f.credits("claude", &setup), "no credit model is configured");
+        setup.config.anthropic_api_model = "claude-opus".into();
+        refused(f.credits("claude", &setup), "credit model is not usable");
+        // The proxy cannot start: no key file.
+        let mut setup = f.setup.clone();
+        setup.config.anthropic_api_key_file = String::new();
+        refused(f.credits("claude", &setup), "credit proxy cannot start");
+        // The listener cannot start.
+        let mut setup = f.setup.clone();
+        setup.listen = Arc::new(|_, _, _, _| Err(std::io::Error::other("no socket")));
+        refused(f.credits("claude", &setup), "credit proxy cannot start");
+        // The cap is reached.
+        let mut setup = f.setup.clone();
+        setup.config.anthropic_api_cap_usd = 0.0;
+        refused(f.credits("claude", &setup), "cap is reached");
+        assert!(f.started.lock().unwrap().is_empty());
+        // The tenure is still frozen and a login handoff still works.
+        assert_eq!(
+            f.supervisor
+                .handoff_prepare_funded("p1", "claude", CoordinatorFunding::Login, None)
+                .unwrap()
+                .credit,
+            None
+        );
+    }
+}
