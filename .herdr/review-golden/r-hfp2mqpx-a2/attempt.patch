+/// An observable end: set once a listener's serving thread has finished, its
+/// grant killed. Waiting on it blocks on that event, not on a clock.
+#[derive(Default)]
+pub(crate) struct Termination {
+    done: Mutex<bool>,
+    changed: std::sync::Condvar,
+}
+
+impl Termination {
+    pub(crate) fn finish(&self) {
+        if let Ok(mut done) = self.done.lock() {
+            *done = true;
+        }
+        self.changed.notify_all();
+    }
+
+    pub(crate) fn is_done(&self) -> bool {
+        self.done.lock().map(|done| *done).unwrap_or(true)
+    }
+
+    /// Blocks until [`Self::finish`] ran.
+    pub(crate) fn wait(&self) {
+        let Ok(mut done) = self.done.lock() else {
+            return;
+        };
+        while !*done {
+            match self.changed.wait(done) {
+                Ok(next) => done = next,
+                Err(_) => return,
+            }
+        }
+    }
+}
