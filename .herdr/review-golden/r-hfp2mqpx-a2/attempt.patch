+//! Process replacement for herdr's credit launcher: the successor's agent is
+//! started with the grant in its own environment and nowhere else.
+
+use std::os::unix::process::CommandExt;
+use std::process::Command;
+
+/// Whether an inherited variable could choose another route or login for
+/// Claude Code than the credit proxy: any `ANTHROPIC_*` setting (key, token,
+/// base URL, model, betas, headers, profile, cloud providers), the
+/// `CLAUDE_CODE_USE_*` provider switches and Claude Code's OAuth tokens.
+pub(crate) fn conflicts_with_credit_launch(name: &str) -> bool {
+    name.starts_with("ANTHROPIC_")
+        || name.starts_with("CLAUDE_CODE_USE_")
+        || name.starts_with("CLAUDE_CODE_OAUTH")
+}
+
+/// The command for `argv` with the conflicting variables of `inherited`
+/// removed and `env` set.
+pub(crate) fn launch_command(
+    argv: &[String],
+    env: &[(String, String)],
+    inherited: impl IntoIterator<Item = String>,
+) -> Option<Command> {
+    let (program, args) = argv.split_first()?;
+    let mut command = Command::new(program);
+    command.args(args);
+    for name in inherited {
+        if conflicts_with_credit_launch(&name) {
+            command.env_remove(name);
+        }
+    }
+    command.envs(env.iter().map(|(name, value)| (name, value)));
+    Some(command)
+}
+
+/// Replaces this process with `argv` under `env`. Returns only the error
+/// that stopped it.
+pub(crate) fn exec_with_env(argv: &[String], env: &[(String, String)]) -> std::io::Error {
+    let inherited = std::env::vars_os().filter_map(|(name, _)| name.into_string().ok());
+    match launch_command(argv, env, inherited) {
+        Some(mut command) => command.exec(),
+        None => std::io::Error::other("no command to launch"),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::ffi::OsStr;
+
+    #[test]
+    fn conflicting_inherited_variables_are_removed_and_the_grant_set() {
+        let argv = ["claude".to_string(), "/todo".to_string()];
+        let env = [
+            (
+                "ANTHROPIC_BASE_URL".to_string(),
+                "http://127.0.0.1:9".to_string(),
+            ),
+            ("ANTHROPIC_AUTH_TOKEN".to_string(), "grant".to_string()),
+        ];
+        let inherited = [
+            "ANTHROPIC_API_KEY",
+            "ANTHROPIC_AUTH_TOKEN",
+            "ANTHROPIC_BASE_URL",
+            "ANTHROPIC_DEFAULT_OPUS_MODEL",
+            "CLAUDE_CODE_USE_BEDROCK",
+            "CLAUDE_CODE_OAUTH_TOKEN",
+            "PATH",
+        ]
+        .map(String::from);
+        let command = launch_command(&argv, &env, inherited).unwrap();
+        let get = |name: &str| {
+            command
+                .get_envs()
+                .find(|(key, _)| *key == OsStr::new(name))
+                .map(|(_, value)| value)
+        };
+        // `None` inside `Some` is an explicit removal.
+        assert_eq!(get("ANTHROPIC_API_KEY"), Some(None));
+        assert_eq!(get("ANTHROPIC_DEFAULT_OPUS_MODEL"), Some(None));
+        assert_eq!(get("CLAUDE_CODE_USE_BEDROCK"), Some(None));
+        assert_eq!(get("CLAUDE_CODE_OAUTH_TOKEN"), Some(None));
+        assert_eq!(get("PATH"), None);
+        assert_eq!(get("ANTHROPIC_AUTH_TOKEN"), Some(Some(OsStr::new("grant"))));
+        assert_eq!(command.get_program(), "claude");
+        assert_eq!(command.get_args().collect::<Vec<_>>(), ["/todo"]);
+        assert!(launch_command(&[], &[], []).is_none());
+    }
+}
