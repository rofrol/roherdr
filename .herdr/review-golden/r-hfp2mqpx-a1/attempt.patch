+            token: "grant-token".into(),
+            model: "claude-sonnet-5-5".into(),
+        };
+        let env = grant.launch_env();
+        let get = |key: &str| {
+            env.iter()
+                .find(|(name, _)| name == key)
+                .map(|(_, value)| value.as_str())
