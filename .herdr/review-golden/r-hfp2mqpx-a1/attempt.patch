+        assert_eq!(get("ANTHROPIC_BASE_URL"), Some("http://127.0.0.1:1"));
+        assert_eq!(get("ANTHROPIC_AUTH_TOKEN"), Some("grant-token"));
+        assert_eq!(get("ANTHROPIC_MODEL"), Some("claude-sonnet-5-5"));
+        assert_eq!(get("ANTHROPIC_API_KEY"), None);
+        assert!(env.iter().all(|(_, value)| !value.starts_with("sk-ant-")));
+        assert!(!format!("{grant:?}").contains("grant-token"));
+    }
