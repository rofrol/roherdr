+/// The argv the pane's shell runs: `argv`, under `env KEY=VALUE ...` when
+/// `env` is not empty, so the variables reach that process alone.
+pub(super) fn typed_launch_argv(argv: &[String], env: &[(String, String)]) -> Vec<String> {
