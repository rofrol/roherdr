+    #[test]
+    fn process_kills_by_pattern_are_denied_and_own_pids_allowed() {
+        let denied = [
+            r#"pkill -f "herdr-""#,
+            "pkill -f nextest",
+            "killall cargo",
+            "/usr/bin/pkill foo",
+            "sudo pkill foo",
+            "env FOO=1 pkill foo",
+            "command killall foo",
+            "ls; pkill foo",
+            "true && pkill foo",
+            "false || pkill foo",
+            "pgrep -f foo | xargs kill",
+            "pgrep foo | xargs -r kill -9",
+            "kill -f foo",
+            "kill foo",
+            "kill -9 -1234",
+            "kill -TERM -- -1234",
+            "kill 0",
+            "kill -1",
+            "kill -9 -1",
+            "kill $(pgrep foo)",
+            "kill `pgrep foo`",
+            "kill -9 $(pgrep -f foo)",
+            "echo $(pkill foo)",
+            "bash -c 'pkill foo'",
+            "kill 12 foo",
+        ];
+        for command in denied {
+            assert_eq!(
+                process_kill_denial("Bash", &json!({"command": command})),
+                Some(PROCESS_KILL_DENIAL),
+                "{command}"
+            );
+        }
+        for command in [
+            "kill 1234",
+            "kill -TERM 1234",
+            "kill -9 1234 5678",
+            "kill -s TERM 1234",
+            "kill %1",
+            "kill -9 %1",
+            "sleep 1 & kill 4242; wait",
+            "echo pkill foo",
+            "cargo nextest run -E 'test(/workers::/)'",
+            "pgrep foo",
+            "kill -l",
+        ] {
+            assert_eq!(
+                process_kill_denial("Bash", &json!({"command": command})),
+                None,
+                "{command}"
+            );
+        }
+        assert_eq!(
+            process_kill_denial("Read", &json!({"command": "pkill x"})),
+            None
+        );
+    }
+
