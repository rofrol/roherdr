#!/usr/bin/env bash
# Link the Pi title extension into Pi's extension directory, so it is updated with this checkout.
# Safe to re-run: an existing link to this file is left alone, anything else under the same name is reported and kept.
# Usage: install [DIR]   (default ~/.pi/agent/extensions)
set -euo pipefail
src="$(cd "$(dirname "$(realpath "$0")")" && pwd)/pi-title.ts"
dest="${1:-$HOME/.pi/agent/extensions}"
target="$dest/herdr-pi-title.ts"
mkdir -p "$dest"
if [ -L "$target" ] && [ "$(realpath "$target")" = "$(realpath "$src")" ]; then
  echo "ok       $target"
elif [ -e "$target" ] || [ -L "$target" ]; then
  echo "skipped  $target exists and is not a link to $src; move it away and re-run" >&2
  exit 1
else
  ln -s "$src" "$target"
  echo "linked   $target -> $src"
fi
