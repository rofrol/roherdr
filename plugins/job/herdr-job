#!/usr/bin/env python3
"""herdr-job: run long commands in their own herdr tab and wait for them.

  herdr-job run --name "Build b17" [--why TEXT] [--keep] [--notify WHEN] [--cwd DIR] [--slot|--exclusive] [--force] [--key KEY] -- COMMAND...
                                 print job id, return at once
  herdr-job watch --pid PID [--name NAME] [--why TEXT]
                                 a job that waits for a process you did not start; print job id
  herdr-job wait ID [--quiet]    follow the log until the job ends; exit with its code
  herdr-job wait-agent PANE [--until STATE | --request ID [--until verdict]]
                                 wait for an agent, its prompt's turn or a pane worker's verdict,
                                 reconnecting inside one job
  herdr-job list                 show jobs and their state
  herdr-job log ID               print the log path
  herdr-job clean [--all]        close tabs of this pane's finished jobs (--all: everyone's)
  herdr-job slot [--exclusive] -- COMMAND   run COMMAND here under a machine-wide slot
  herdr-job slots                who holds the slots
  herdr-job clean-tree [--then CMD] [PATH...] -- COMMAND   run COMMAND in a clean tree: HEAD plus only these paths

The job runs in a new unfocused tab, so its output is visible live. The pane
that started it (HERDR_PANE_ID) gets a `$jobs` sidebar token. Any agent can use
it: the state lives in files under ~/.local/state/herdr-job/, not in the agent.
"""
import argparse
import collections
import contextlib
import fcntl
import json
import os
import re
import secrets
import shlex
import signal
import subprocess
import sys
import tempfile
import threading
import time
import unicodedata
from pathlib import Path

STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "herdr-job"
SELF = Path(__file__).resolve()
HERDR = os.environ.get("HERDR_BIN_PATH", "")
if not os.access(HERDR, os.X_OK):
    HERDR = "herdr"
# A backstop: the counts follow the job tabs, which the hooks track.
TOKEN_TTL_MS = 24 * 60 * 60 * 1000
EXIT_LOST = 125
CLOSE_OK_AFTER_S = 10
# How often a succeeded job whose tab is focused checks whether you left it.
FOCUSED_POLL_S = 2
# Keeps the typed `_exec` line out of zsh's history file; the leading space
# keeps it out of atuin. zsh imports it from the environment.
HISTORY_IGNORE = "*herdr-job _exec *"


def herdr(*args, check=True):
    try:
        out = subprocess.run([HERDR, *args], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired) as err:
        # A live handoff can leave the socket unanswered for a while.
        if check:
            raise SystemExit(f"herdr {' '.join(args)} failed: {err}") from err
        return ""
    if check and out.returncode != 0:
        raise SystemExit(f"herdr {' '.join(args)} failed: {out.stderr.strip() or out.stdout.strip()}")
    return out.stdout


def herdr_ok(*args):
    """Runs a herdr command that older herdr builds may not have."""
    try:
        out = subprocess.run([HERDR, *args], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return out.returncode == 0


def job_dir(job_id):
    path = STATE / job_id
    if not (path / "meta.json").exists():
        raise SystemExit(f"no such job: {job_id}")
    return path


def read_meta(path):
    return json.loads((path / "meta.json").read_text())


def write_atomic(target, text):
    # A temporary name of its own, so two writers cannot tear each other's file.
    fd, tmp = tempfile.mkstemp(prefix=target.name + ".", suffix=".tmp", dir=target.parent)
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write(text)
        os.replace(tmp, target)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


def write_meta(path, meta):
    write_atomic(path / "meta.json", json.dumps(meta, ensure_ascii=False, indent=2))


def pid_alive(pid):
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def lock_held(path, meta):
    """Whether the job still runs: `_exec` takes an exclusive flock on `lock`
    and its command inherits the descriptor, so the lock is held while the
    executor, the command or any child that kept the descriptor lives. The
    kernel drops it when the last of them ends however they die, so a reused
    PID after a crash or reboot cannot fake a running job."""
    try:
        fd = os.open(path / "lock", os.O_RDWR)
    except FileNotFoundError:
        return pid_alive(meta.get("pid"))  # job started before lock files existed
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return True
    except OSError:
        return pid_alive(meta.get("pid"))
    finally:
        os.close(fd)
    return False


def finished(path):
    exit_file = path / "exit"
    if not exit_file.exists():
        return None
    code = int(exit_file.read_text().strip() or EXIT_LOST)
    return ("ok" if code == 0 else "failed"), code


def tab_shows_job(tabs, meta):
    """Whether the job's tab is open and still carries its label (a reused tab
    id or a tab the user renamed is not the job's)."""
    tab = tabs.get(meta.get("tab_id"))
    return tab is not None and tab.get("label") in job_labels(meta)


def status(path, meta=None, tabs=None):
    """pending | running | ok | failed | lost, plus the exit code when finished.

    `lost` is a fact, never a duration: a started job is lost once nothing
    holds its lock and it wrote no `exit`; a job whose executor has not
    started yet stays pending while its tab is open, and is lost only once
    the tab is gone. `tabs` (tab id → tab) saves the lookup when the caller
    has them; when herdr does not answer, the job stays pending."""
    meta = meta or read_meta(path)
    if result := finished(path):
        return result
    if launching(path, meta):
        if launcher_alive(path):
            return "pending", None
        # Its launcher died before the launch was through: settle the record.
        if not resolve_launch(path, tabs):
            return "pending", None
        meta = read_meta(path)
        if result := finished(path):
            return result
    if lock_held(path, meta):
        return "running", None
    # `_exec` may have written `exit` and let go of the lock between the checks.
    if result := finished(path):
        return result
    if "started" in meta:
        return "lost", EXIT_LOST
    if tabs is None:
        try:
            tabs = {tab["tab_id"]: tab for tab in list_tabs()}
        except (SystemExit, ValueError, KeyError, TypeError):
            return "pending", None
    if tab_shows_job(tabs, meta):
        return "pending", None
    # The executor may have started and taken the lock after the probe above.
    if lock_held(path, meta):
        return "running", None
    return finished(path) or ("lost", EXIT_LOST)


def active(st):
    """A job that has not ended: it holds its place in counts and waits."""
    return st in ("pending", "running")


def all_jobs():
    if not STATE.exists():
        return []
    jobs = []
    for path in sorted(STATE.iterdir()):
        if (path / "meta.json").exists():
            jobs.append((path, read_meta(path)))
    return jobs


def short(text, width=40):
    text = " ".join(str(text).split())
    return text if len(text) <= width else text[: width - 1] + "…"


def list_tabs():
    return json.loads(herdr("tab", "list"))["result"]["tabs"]


def final_tab_status(code):
    return "succeeded" if code == 0 else "failed"


def set_final_tab_status(meta, code):
    """The job's last word to herdr. A live handoff can leave the server
    unreachable for a while, so retry with backoff instead of leaving the tab
    at ⧖; `reconcile_tabs` repairs whatever still slips through."""
    for delay in (0, 1, 2, 4, 8, 15, 30):
        time.sleep(delay)
        if herdr_ok("tab", "status", meta["tab_id"], final_tab_status(code)):
            return


def job_labels(meta):
    """The labels a job's tab carries: herdr builds without tab statuses get
    the state icon in the label."""
    name = short(meta["name"], 30)
    labels = {name} if meta.get("tab_status") else {f"{mark} {name}" for mark in "⧖✓✗"}
    if meta.get("intent"):
        labels.add(intent_label(meta))
    return labels


# A launch is a sequence the launcher can die in the middle of: the job's
# record comes first (`pending`, with an intent id, while the launcher holds
# the job's `launch.lock`), then a tab created with the intent id in its
# label, then the tab id in the record, the tab's real label, and the `pane
# run` that starts the executor; a `launched` file ends it. Until then, a record whose launcher is
# gone is settled by `resolve_launch`, so a crash at any step leaves no tab
# nobody owns and no job that stays pending for ever.
LAUNCHED = "launched"


def intent_label(meta):
    """The label a job's tab is created with, before the record knows the tab."""
    return f"{short(meta['name'], 30)} ·{meta['intent']}"


def launching(path, meta):
    return bool(meta.get("intent")) and not (path / LAUNCHED).exists()


LAUNCH_HOLD = "launch.lock"


def hold_launch(path):
    """Taken by the launcher before it writes the job's first record and
    held until it exits. The kernel drops the lock however the launcher
    ends, so neither a reused pid nor a slow launch is taken for a live one."""
    fd = os.open(path / LAUNCH_HOLD, os.O_CREAT | os.O_RDWR, 0o600)
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


def launcher_alive(path):
    """Whether the process that launches the job still runs (`hold_launch`)."""
    try:
        fd = os.open(path / LAUNCH_HOLD, os.O_RDWR)
    except FileNotFoundError:
        return False
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return True
    finally:
        os.close(fd)
    return False


def resolve_launch(path, tabs=None):
    """Settles a launch whose launcher died. A job whose executor took its
    lock or started is adopted (it runs, or ran, in its recorded tab); one
    that never started gets its tab closed, found by the recorded id or the
    intent id in the label, and is marked failed (exit 125). Returns False
    when it cannot decide now (herdr does not answer, or the tab does not
    close), so the record stays pending and the next look tries again.

    Concurrent resolvers queue on `resolve.lock`; the job's own `lock`, held
    here while deciding, keeps `_exec` from starting meanwhile, and `_exec`
    refuses a job that has an `exit` file."""
    with flocked(path / "resolve.lock"):
        if finished(path) or (path / LAUNCHED).exists():
            return True
        if launcher_alive(path):
            return False
        fd = os.open(path / "lock", os.O_CREAT | os.O_RDWR, 0o600)
        try:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                write_atomic(path / LAUNCHED, "adopted: the executor runs\n")
                return True
            meta = read_meta(path)
            if "started" in meta:
                write_atomic(path / LAUNCHED, "adopted: the executor started\n")
                return True
            if tabs is None:
                try:
                    tabs = {tab["tab_id"]: tab for tab in list_tabs()}
                except (SystemExit, ValueError, KeyError, TypeError):
                    return False
            # The record knows its tab's status before the tab gets its real label.
            mine = [tab_id for tab_id, tab in tabs.items()
                    if tab.get("label") == intent_label(meta)
                    or (tab_id == meta.get("tab_id") and tab.get("label") in job_labels(meta))]
            for tab_id in mine:
                if not herdr_ok("tab", "close", tab_id):
                    return False
                tabs.pop(tab_id)  # the caller's view of the tabs stays true
            with open(path / "log", "a") as log:
                log.write("herdr-job: the launch stopped before the job started (its launcher is gone); "
                          f"{'closed its tab' if mine else 'it had no tab'}, nothing ran\n")
            write_atomic(path / "exit", f"{EXIT_LOST}\n")
            return True
        finally:
            os.close(fd)


def job_tabs(tabs):
    """Maps each open tab to the job that owns it, from `tabs` (tab id → tab).

    Tab ids can come back after a restart, so only the newest job of a tab
    decides, and only while the tab still carries that job's label: a job
    starting right now may hold a reused id before its meta.json exists, and
    a label the user changed means the tab is theirs now."""
    newest = {}
    for path, meta in all_jobs():
        tab_id = meta.get("tab_id")
        if tab_id in tabs and (tab_id not in newest or meta["created"] > newest[tab_id][1]["created"]):
            newest[tab_id] = (path, meta)
    return {tab_id: job for tab_id, job in newest.items() if tabs[tab_id].get("label") in job_labels(job[1])}


def close_due(meta, st):
    return st == "ok" and not meta.get("keep") and time.time() - meta.get("ended", 0) >= CLOSE_OK_AFTER_S


def close_job_tab(meta):
    """Close a succeeded job's tab, but not while it is the focused tab: you
    are reading it, so it closes once you leave it. A live handoff can leave
    the server unreachable for a while, so retry with backoff; stop once the
    tab is gone or no longer this job's. `reconcile_tabs` closes whatever
    still slips through."""
    delays = iter((0, 1, 2, 4, 8, 15, 30))
    delay = next(delays)
    while delay is not None:
        time.sleep(delay)
        try:
            tabs = {tab["tab_id"]: tab for tab in list_tabs()}
        except (SystemExit, ValueError, KeyError):
            delay = next(delays, None)
            continue
        owner = job_tabs(tabs).get(meta["tab_id"])
        if not owner or owner[1]["id"] != meta["id"]:
            return
        if tabs[meta["tab_id"]].get("focused"):
            delay = FOCUSED_POLL_S
            continue
        if herdr_ok("tab", "close", meta["tab_id"]):
            return
        delay = next(delays, None)


def reconcile_tabs():
    """Repair job tabs the job's own last herdr calls missed, e.g. during a
    live handoff: a tab still marked running whose job has ended gets its
    final status, and a succeeded job's tab closes as it would have (unless
    `--keep`). A job without an `exit` file that is no longer running (lost)
    is marked failed, never succeeded. A tab with no status at all gets one
    too: a cold server start (a reboot) restores a running tab without its
    status, and the sidebar would draw its job as a bare dot."""
    try:
        tabs = {tab["tab_id"]: tab for tab in list_tabs()}
    except (SystemExit, ValueError, KeyError):
        return
    for tab_id, (path, meta) in job_tabs(tabs).items():
        st, code = status(path, meta, tabs)
        # Settling a dead launcher's job closes its tab (`resolve_launch`).
        if active(st) or tab_id not in tabs:
            continue
        if meta.get("tab_status") and tabs[tab_id].get("status") in ("running", None):
            herdr_ok("tab", "status", tab_id, final_tab_status(code))
        # A focused tab is being read; its job's own `close_job_tab` waits.
        if close_due(meta, st) and not tabs[tab_id].get("focused"):
            herdr_ok("tab", "close", tab_id)


def update_owner_token(owner_pane):
    """Summarise the owner's jobs that still have a tab into its `$jobs`
    sidebar token as counts, e.g. `⧖ 2 !1 ✓1`: the agents panel cannot
    scroll, so a list of names would push other agents out of view. A closed
    tab drops its job from the counts (the `tab.closed` hook recounts)."""
    if not owner_pane:
        return
    try:
        tabs = {tab["tab_id"]: tab for tab in list_tabs()}
    except (SystemExit, ValueError, KeyError):
        return
    counts = {"running": 0, "failed": 0, "ok": 0}
    for path, meta in all_jobs():
        if meta.get("owner_pane") != owner_pane or meta.get("tab_id") not in tabs:
            continue
        st, _ = status(path, meta, tabs)
        counts["running" if active(st) else "failed" if st == "lost" else st] += 1
    # The icons and order of herdr's own job counts (tab bar, space row):
    # `!`, not `✗`, and `⧖` spaced from its digit, which it runs into.
    marks = (("running", "⧖ "), ("failed", "!"), ("ok", "✓"))
    parts = [f"{mark}{counts[key]}" for key, mark in marks if counts[key]]
    cmd = ["pane", "report-metadata", owner_pane, "--source", "herdr-job"]
    if parts:
        cmd += ["--token", f"jobs={' '.join(parts)}", "--ttl-ms", str(TOKEN_TTL_MS)]
    else:
        cmd += ["--clear-token", "jobs"]
    herdr(*cmd, check=False)


def cmd_tab_closed(_args):
    """`tab.closed` plugin hook: recount the jobs of the pane that started
    the job whose tab was closed."""
    def find_tab_id(value):
        if isinstance(value, dict):
            if isinstance(value.get("tab_id"), str):
                return value["tab_id"]
            value = list(value.values())
        if isinstance(value, list):
            for item in value:
                if found := find_tab_id(item):
                    return found
        return None

    try:
        tab_id = find_tab_id(json.loads(os.environ.get("HERDR_PLUGIN_EVENT_JSON", "")))
    except ValueError:
        return
    reconcile_tabs()
    for _, meta in all_jobs():
        if meta.get("tab_id") == tab_id:
            update_owner_token(meta.get("owner_pane"))
            return


def top_level_tab(tab_id):
    """Tabs nest one level only, so a job started from a job tab goes under that tab's parent."""
    try:
        tab = json.loads(herdr("tab", "get", tab_id))["result"]["tab"]
    except (SystemExit, ValueError, KeyError, TypeError):
        return tab_id
    return tab.get("parent_tab_id") or tab_id


def create_job_tab(create, workspace_id, parent_tab):
    """Create the job's tab already nested under `parent_tab` and return
    herdr's create result. Nested at creation, it never shows as a top-level
    tab of the space for the moment before it nests (the rows below it would
    jump). Herdr builds without `tab create --parent` reject it; there the tab
    is created in the workspace and nested afterwards."""
    if parent_tab:
        out = herdr(*create, "--parent", parent_tab, check=False)
        try:
            created = json.loads(out)["result"]
            created["tab"]["tab_id"]
            return created
        except (ValueError, KeyError, TypeError):
            pass
    if workspace_id:
        create = [*create, "--workspace", workspace_id]
    created = json.loads(herdr(*create))["result"]
    tab_id = created["tab"]["tab_id"]
    if parent_tab and not herdr_ok("tab", "parent", tab_id, parent_tab):
        print(f"herdr-job: could not nest tab {tab_id} under {parent_tab}", file=sys.stderr)
    return created


# Slots: machine-wide admission for heavy work (builds, test suites,
# benchmarks), so several sessions do not run full-machine workloads at once.
# cargo and nextest each use every core, so the default is one slot; cargo's own
# lock on target/ does not cover this, because nextest runs the tests after it
# has released that lock, and worktrees have their own target/.
SLOTS = STATE / "slots"
SLOT_ENV = "HERDR_JOB_SLOT"
# flock has no wait-for-any-of-N, so a shared request with several slots polls them.
SLOT_POLL_S = 0.5


def slot_count():
    """HERDR_JOB_SLOTS (default 1); 0 turns slots off, e.g. on a CI runner."""
    try:
        return max(0, int(os.environ.get("HERDR_JOB_SLOTS", "1")))
    except ValueError:
        raise SystemExit("HERDR_JOB_SLOTS must be a number") from None


def slot_files():
    SLOTS.mkdir(parents=True, exist_ok=True)
    return [SLOTS / f"slot-{index}" for index in range(slot_count())]


def slot_holder(path):
    """Who holds a slot, from the note its holder wrote, or None when it is free.
    The flock decides, not the note: a note outlives a holder that crashed."""
    try:
        fd = os.open(path, os.O_RDWR)
    except FileNotFoundError:
        return None
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        try:
            return json.loads(path.with_suffix(".json").read_text())
        except (OSError, ValueError):
            return {}
    finally:
        os.close(fd)
    return None


def describe_holder(holder):
    if not holder:
        return "unknown holder"
    since = time.strftime("%H:%M", time.localtime(holder.get("since", 0)))
    job = f"job {holder['job']} " if holder.get("job") else ""
    return f"{job}{short(holder.get('name') or '?', 50)} (pid {holder.get('pid')}, since {since})"


def take_slot(name, exclusive=False, job_id=None, on_wait=None):
    """Takes one slot, or every slot with `exclusive`, and returns the open
    files that hold them (the flocks last until they are closed or the process
    dies). Returns [] when the caller already runs inside a slot or slots are
    off. `on_wait(text)` hears once that the request has to wait, and who for."""
    inside = os.environ.get(SLOT_ENV)
    if inside:
        if exclusive and inside != "exclusive":
            # Waiting would deadlock on the slot our own ancestor holds.
            raise SystemExit("herdr-job: an exclusive slot cannot be taken inside a shared one; "
                             "run the exclusive command on its own")
        return []
    paths = slot_files()
    if not paths:
        return []
    handles = [open(path, "a") for path in paths]
    held = []

    def holders():
        # Not the slots this request already holds: their notes are the previous holders'.
        mine = {handle.name for handle in held}
        found = [slot_holder(path) for path in paths if str(path) not in mine]
        return "; ".join(describe_holder(holder) for holder in found if holder is not None) or "nobody now"

    def try_lock(handle):
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return True
        except BlockingIOError:
            return False

    try:
        if exclusive:
            # A fixed order, so two exclusive requests cannot deadlock.
            # Slots it already holds stay closed to newcomers while it waits for the rest.
            told = False
            for handle in handles:
                if not try_lock(handle):
                    if on_wait and not told:
                        on_wait(f"waiting for every slot (exclusive); held by {holders()}")
                        told = True
                    fcntl.flock(handle, fcntl.LOCK_EX)
                held.append(handle)
        else:
            told = False
            while not held:
                free = next((handle for handle in handles if try_lock(handle)), None)
                if free:
                    held.append(free)
                    break
                if on_wait and not told:
                    on_wait(f"waiting for a slot held by {holders()}")
                    told = True
                time.sleep(SLOT_POLL_S)
    except BaseException:
        for handle in handles:
            handle.close()
        raise
    for handle in handles:
        if handle not in held:
            handle.close()
    note = {"pid": os.getpid(), "job": job_id, "name": name, "since": time.time(),
            "exclusive": exclusive}
    for handle in held:
        write_atomic(Path(handle.name).with_suffix(".json"), json.dumps(note, ensure_ascii=False))
    os.environ[SLOT_ENV] = "exclusive" if exclusive else "shared"
    return held


def cmd_slot(args):
    """Runs a command in the foreground under a slot, for `just` recipes."""
    if not args.command:
        raise SystemExit("usage: herdr-job slot [--exclusive] [--name NAME] -- COMMAND...")
    name = args.name or shlex.join(args.command)
    held = take_slot(name, args.exclusive, on_wait=lambda text: print(f"herdr-job: {text}", file=sys.stderr, flush=True))
    try:
        # The command inherits the slot, so it stays taken until the command ends.
        proc = subprocess.Popen(args.command, pass_fds=[handle.fileno() for handle in held])
    except OSError as err:
        raise SystemExit(f"herdr-job slot: {err}") from err

    def forward(signum, _frame):
        if proc.returncode is None:
            proc.send_signal(signum)

    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, forward)
    code = proc.wait()
    for handle in held:
        handle.close()
    sys.exit(128 - code if code < 0 else code)


# Clean tree: builds and tests that verify one session's change, without the
# half-done edits other sessions left in a shared checkout. One persistent
# worktree per repository (ignored build output such as target/ stays warm) is
# reset to the checkout's HEAD and gets only the paths the caller names: the
# shared checkout cannot tell whose edits are whose, so `git diff` of all of it
# would bring the others' work along.


def git_run(cwd, *args, binary=False):
    out = subprocess.run(["git", "-C", str(cwd), *args], capture_output=True, text=not binary)
    if out.returncode != 0:
        err = out.stderr.decode(errors="replace") if binary else out.stderr
        raise SystemExit(f"git {' '.join(args)} failed: {err.strip()}")
    return out.stdout


def checkout_root():
    return Path(git_run(Path.cwd(), "rev-parse", "--show-toplevel").strip()).resolve()


def clean_tree_dir(root):
    """$HERDR_CLEAN_TREE, else `<repo>-worktrees/clean-check` next to the checkout."""
    configured = os.environ.get("HERDR_CLEAN_TREE")
    if configured:
        return Path(configured).expanduser().resolve()
    return (root.parent / f"{root.name}-worktrees" / "clean-check").resolve()


def lock_clean_tree(root):
    """One run at a time per repository; the holder note says who waits for whom."""
    common = Path(git_run(root, "rev-parse", "--git-common-dir").strip())
    handle = open((common if common.is_absolute() else root / common) / "clean-tree.lock", "a+")
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        handle.seek(0)
        print(f"herdr-job: clean tree busy ({handle.read().strip() or 'another run'}); waiting",
              file=sys.stderr, flush=True)
        fcntl.flock(handle, fcntl.LOCK_EX)
    handle.seek(0)
    handle.truncate()
    handle.write(f"pid {os.getpid()}: {short(' '.join(sys.argv[2:]), 200)}\n")
    handle.flush()
    return handle


def snapshot_inputs(root, paths):
    """Reads the clean tree's inputs once: HEAD as a commit id and the named
    paths' working copy as a tree object written from a throwaway index (the
    checkout's own index stays untouched). Other sessions commit to the
    checkout meanwhile; everything after this reads the snapshot, not the
    checkout, so a commit made in between cannot mix into the run."""
    for path in paths:
        resolved = (root / path).resolve()
        if resolved != root and root not in resolved.parents:
            raise SystemExit(f"herdr-job: {path} is outside {root}")
    base = git_run(root, "rev-parse", "--verify", "HEAD^{commit}").strip()
    if not paths:
        return base, git_run(root, "rev-parse", f"{base}^{{tree}}").strip()
    with tempfile.TemporaryDirectory(prefix="herdr-clean-tree.") as scratch:
        env = dict(os.environ, GIT_INDEX_FILE=str(Path(scratch) / "index"))

        def indexed(*args):
            out = subprocess.run(["git", "-C", str(root), *args], capture_output=True, text=True, env=env)
            if out.returncode != 0:
                raise SystemExit(f"git {' '.join(args)} failed: {out.stderr.strip()}")
            return out.stdout

        indexed("read-tree", base)
        # -A takes edits, deletions and new files, and skips ignored ones.
        indexed("add", "-A", "--", *paths)
        return base, indexed("write-tree").strip()


def apply_snapshot(root, tree, snapshot):
    """Resets the tree to the snapshot's commit and applies the difference to
    its tree object, both read from the object store, not the checkout."""
    base, contents = snapshot
    if not (tree / ".git").exists():
        tree.parent.mkdir(parents=True, exist_ok=True)
        git_run(root, "worktree", "add", "--detach", str(tree), base)
    git_run(tree, "checkout", "--detach", "--force", base)
    git_run(tree, "clean", "-fd")  # not -x: ignored build output stays warm
    patch = git_run(tree, "diff", "--binary", base, contents, binary=True)
    if patch:
        applied = subprocess.run(["git", "-C", str(tree), "apply", "--binary", "-"], input=patch,
                                 capture_output=True)
        if applied.returncode != 0:
            raise SystemExit(f"herdr-job: the patch does not apply: {applied.stderr.decode(errors='replace').strip()}")
    return git_run(tree, "status", "--porcelain").count("\n")


def prepare_clean_tree(root, tree, paths):
    """Resets the tree to the checkout's HEAD plus the named paths' changes."""
    snapshot = snapshot_inputs(root, paths)
    return snapshot[0], apply_snapshot(root, tree, snapshot)


# The identity a herdr build prints first in `--build-commit` (build.rs): the
# short HEAD hash, and for uncommitted sources `~` and the short hash of HEAD's
# tree with the working copy of these paths. Keep both in step with build.rs.
BUILD_SOURCES = ("src", "build.rs", "Cargo.toml", "Cargo.lock")


def build_identity(tree):
    def git(*args, env=None):
        """The output, or None when git fails (build.rs then goes without)."""
        out = subprocess.run(["git", "-C", str(tree), *args], capture_output=True, text=True, env=env)
        return out.stdout.strip() if out.returncode == 0 else None

    commit = git("log", "-1", "--format=%h", "HEAD") or ""
    if not commit or not git("status", "--porcelain", "--", *BUILD_SOURCES):
        return commit
    with tempfile.TemporaryDirectory(prefix="herdr-build-identity.") as scratch:
        env = dict(os.environ, GIT_INDEX_FILE=str(Path(scratch) / "index"))
        if git("read-tree", "HEAD", env=env) is None or git("add", "-A", "--", *BUILD_SOURCES, env=env) is None:
            return commit
        sources = git("write-tree", env=env)
    return f"{commit}~{sources[:7]}" if sources else commit


def cmd_clean_tree(args):
    if args.print_path:
        print(clean_tree_dir(checkout_root()))
        return
    argv = args.rest
    if "--" not in argv or argv.index("--") == len(argv) - 1:
        raise SystemExit("usage: herdr-job clean-tree [--then SHELL-COMMAND] [PATH...] -- COMMAND...")
    split = argv.index("--")
    paths, command = argv[:split], argv[split + 1:]
    if "--then" in paths:
        raise SystemExit("herdr-job: put --then before the paths")
    root = checkout_root()
    tree = clean_tree_dir(root)
    if root == tree:
        raise SystemExit("herdr-job: run clean-tree from the shared checkout, not from the clean tree")
    lock = lock_clean_tree(root)
    try:
        base, changed = prepare_clean_tree(root, tree, paths)
        print(f"herdr-job: clean tree {tree}: {base[:12]} + {changed} changed paths", file=sys.stderr, flush=True)
        env = dict(os.environ, HERDR_CLEAN_TREE_BASE=base, HERDR_CLEAN_TREE_BUILD=build_identity(tree))
        # The commands inherit the lock: if this process dies, nobody resets
        # the tree under a build that still runs in it.
        keep = (lock.fileno(),)
        code = subprocess.run(command, cwd=tree, env=env, pass_fds=keep).returncode
        # Still under the lock: nobody can reset the tree or rebuild its
        # output between the command and this one (an install of that build).
        if code == 0 and args.then:
            code = subprocess.run(["sh", "-c", args.then], cwd=tree, env=env, pass_fds=keep).returncode
    finally:
        lock.close()
    sys.exit(128 - code if code < 0 else code)


def cmd_slots(_args):
    paths = slot_files()
    if not paths:
        print("slots are off (HERDR_JOB_SLOTS=0)")
    for index, path in enumerate(paths):
        holder = slot_holder(path)
        print(f"slot {index}: " + ("free" if holder is None else describe_holder(holder)))


def job_slot(args):
    """The slot a new job waits for. A job started from inside a slot runs in a
    new tab that does not inherit the mark, so it would wait for the slot its
    own waiting parent holds: it shares the parent's admission instead."""
    wanted = "exclusive" if args.exclusive else "shared" if args.slot else None
    inside = os.environ.get(SLOT_ENV)
    if wanted and inside:
        if wanted == "exclusive" and inside != "exclusive":
            raise SystemExit("herdr-job: an exclusive slot cannot be taken inside a shared one; "
                             "run the exclusive command on its own")
        return None
    return wanted


# Guards against runaway launches. A coordinator once retried its wait for a
# worker in a loop, each attempt through `herdr-job run`: every attempt opened
# a tab (a PTY) and failed ones stayed open, ~400 tabs until macOS ran out of
# PTYs and herdr could not open a tab anywhere. The caps are checked before the
# job's tab exists, under one lock, so concurrent launches cannot pass them
# together; the failure counters live on disk, because the retries began when
# a herdr server restart broke the waits.
LAUNCH_LOCK = STATE / "launch.lock"
FAILURES = STATE / "failures.json"
FAILURES_LOCK = STATE / "failures.lock"
NAME_FAILURES_MAX = 3
NAME_FAILURES_WINDOW_S = 600


def env_limit(name, default):
    try:
        return max(0, int(os.environ.get(name, default)))
    except ValueError:
        raise SystemExit(f"{name} must be a number") from None


def max_per_owner():
    """Running jobs plus kept failed job tabs per owner pane."""
    return env_limit("HERDR_JOB_MAX_PER_OWNER", 16)


def max_global():
    return env_limit("HERDR_JOB_MAX_GLOBAL", 64)


def max_failed_kept():
    return env_limit("HERDR_JOB_MAX_FAILED_KEPT", 8)


def job_owner(meta):
    """The pane a job counts against: the original owner of nested jobs."""
    return meta.get("root_owner", meta.get("owner_pane"))


def root_owner(pane):
    """The pane a new job counts against. A job started from inside a job (its
    command has HERDR_JOB_ID) or from a job tab's shell belongs to whoever
    started that job, so a nested launch cannot escape the owner's cap."""
    parent = os.environ.get("HERDR_JOB_ID")
    if parent and re.fullmatch(r"[0-9a-f-]+", parent) and (STATE / parent / "meta.json").exists():
        try:
            return job_owner(read_meta(STATE / parent))
        except (OSError, ValueError):
            pass
    if pane:
        for _, meta in all_jobs():
            if meta.get("pane_id") == pane:
                return job_owner(meta)
    return pane


@contextlib.contextmanager
def flocked(path):
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "a") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield


def failure_key(owner, name):
    return f"{owner or ''}\t{name}"


def recent_failures(owner, name, now=None):
    now = now or time.time()
    try:
        times = json.loads(FAILURES.read_text()).get(failure_key(owner, name), [])
    except (OSError, ValueError, AttributeError):
        return 0
    return sum(1 for t in times if now - t < NAME_FAILURES_WINDOW_S)


def record_failure(owner, name, now=None):
    """Counts a failed job by owner and name, on disk: a counter in memory
    would not survive the server restart that starts a retry loop."""
    now = now or time.time()
    with flocked(FAILURES_LOCK):
        try:
            data = json.loads(FAILURES.read_text())
            if not isinstance(data, dict):
                data = {}
        except (OSError, ValueError):
            data = {}
        data = {key: kept for key, times in data.items()
                if (kept := [t for t in times if now - t < NAME_FAILURES_WINDOW_S])}
        data.setdefault(failure_key(owner, name), []).append(now)
        write_atomic(FAILURES, json.dumps(data))


def job_tab_counts(tabs):
    """Running jobs and failed (or lost) jobs whose tab is still open, per
    owner, and the failed ones oldest first. A job that has not started yet
    counts as running, so a launch in progress holds its place."""
    # The states first: settling a dead launcher's job may close its tab.
    states = [(path, meta, status(path, meta, tabs)[0]) for path, meta in all_jobs()]
    owned = job_tabs(tabs)
    running, failed = collections.Counter(), collections.defaultdict(list)
    for path, meta, st in states:
        if active(st):
            running[job_owner(meta)] += 1
        elif st in ("failed", "lost") and owned.get(meta.get("tab_id"), (None,))[0] == path:
            failed[job_owner(meta)].append(meta)
    for metas in failed.values():
        metas.sort(key=lambda meta: meta["created"])
    return running, failed


def prune_failed_tabs(owner, tabs, failed):
    """Closes the owner's oldest failed job tabs beyond the kept number; the
    logs stay in the state directory. The focused tab is never closed."""
    metas = failed.get(owner, [])
    excess = len(metas) - max_failed_kept()
    for meta in list(metas):
        if excess <= 0:
            break
        if tabs.get(meta["tab_id"], {}).get("focused"):
            continue
        if herdr_ok("tab", "close", meta["tab_id"]):
            metas.remove(meta)
            excess -= 1


def check_launch(owner, name, force):
    """Refuses a launch over the caps, before its tab exists. Runs under
    LAUNCH_LOCK, held until the new job's tab is recorded."""
    if not force and (failures := recent_failures(owner, name)) >= NAME_FAILURES_MAX:
        raise SystemExit(
            f"herdr-job: not starting {name!r}: it failed {failures} times in the last "
            f"{NAME_FAILURES_WINDOW_S // 60} minutes for pane {owner or '(none)'}; fix the cause or pass --force "
            "(never retry `herdr-job run` in a loop)")
    tabs = {tab["tab_id"]: tab for tab in list_tabs()}
    running, failed = job_tab_counts(tabs)
    prune_failed_tabs(owner, tabs, failed)
    mine_running, mine_failed = running[owner], len(failed.get(owner, []))
    if mine_running + mine_failed >= max_per_owner():
        raise SystemExit(
            f"herdr-job: not starting {name!r}: pane {owner or '(none)'} has {mine_running} running and "
            f"{mine_failed} failed job tabs (limit {max_per_owner()}); close finished ones with `herdr-job clean`")
    all_running = sum(running.values())
    all_failed = sum(len(metas) for metas in failed.values())
    if all_running + all_failed >= max_global():
        raise SystemExit(
            f"herdr-job: not starting {name!r}: {all_running} running and {all_failed} failed job tabs "
            f"in all panes (limit {max_global()}); close finished ones with `herdr-job clean --all`")


def cmd_run(args):
    if not args.command:
        raise SystemExit("usage: herdr-job run --name NAME -- COMMAND...")
    owner = os.environ.get("HERDR_PANE_ID")
    if not os.environ.get("HERDR_SOCKET_PATH"):
        raise SystemExit("herdr-job needs to run inside a herdr pane")
    key = getattr(args, "key", None)
    with flocked(LAUNCH_LOCK):
        # A retry whose first reply was lost gets the job it already started,
        # whatever its state; the key is recorded under this lock with the job.
        if key is not None and (existing := job_with_key(key)):
            print(existing["id"])
            return
        root = root_owner(owner)
        check_launch(root, args.name, getattr(args, "force", False))
        # The lock is held until the job's tab is recorded: the job counts
        # from its first record on, and the key is taken with it.
        meta = start_job(args, owner, root, key)
    launch_started_job(meta)


def job_with_key(key):
    """The newest job started with this `--key`, or None."""
    found = [meta for _, meta in all_jobs() if meta.get("key") == key]
    return max(found, key=lambda meta: meta["created"]) if found else None


def start_job(args, owner, root, key=None):
    cwd = str(Path(args.cwd or os.getcwd()).resolve())
    command = args.command[0] if len(args.command) == 1 else shlex.join(args.command)
    job_id = time.strftime("%Y%m%d-%H%M%S-") + secrets.token_hex(2)
    origin = "started by hand"
    owner_is_agent = False
    if owner:
        pane = json.loads(herdr("pane", "get", owner))["result"]["pane"]
        workspace = json.loads(herdr("workspace", "get", pane["workspace_id"]))["result"]["workspace"]
        origin = f"from {pane.get('agent') or 'pane ' + owner} in {workspace.get('label') or pane['workspace_id']}"
        owner_is_agent = bool(pane.get("agent"))
    # The record first, so a launcher that dies from here on leaves something
    # `herdr-job` sees and settles (`resolve_launch`); the tab carries the
    # intent id in its label until the record names it.
    path = STATE / job_id
    path.mkdir(parents=True, mode=0o700)
    hold_launch(path)  # held until this process exits
    meta = {
        "id": job_id,
        "name": args.name,
        "command": command,
        "cwd": cwd,
        "why": args.why,
        "keep": args.keep,
        "slot": job_slot(args),
        # An agent reports its own jobs when `herdr-job wait` wakes it; a person
        # who started a job by hand has nobody else to tell them.
        "notify": args.notify or ("never" if owner_is_agent else "always"),
        "origin": origin,
        "owner_pane": owner,
        "root_owner": root,
        "intent": secrets.token_hex(4),
        "launcher_pid": os.getpid(),
        "created": time.time(),
    }
    if key is not None:
        meta["key"] = key
    write_meta(path, meta)
    create = ["tab", "create", "--no-focus", "--label", intent_label(meta), "--cwd", cwd]
    create += ["--env", f"HISTORY_IGNORE={HISTORY_IGNORE}"]
    # herdr nests the tab under the agent's tab (a second tab row with a
    # summary on the agent's tab) and draws the state icon from the tab status.
    # Older herdr builds have neither, so the label carries the icon there.
    parent_tab = top_level_tab(pane["tab_id"]) if owner and pane.get("tab_id") else None
    created = create_job_tab(create, pane["workspace_id"] if owner else None, parent_tab)
    meta["tab_id"] = created["tab"]["tab_id"]
    meta["pane_id"] = created["root_pane"]["pane_id"]
    meta["tab_status"] = herdr_ok("tab", "status", meta["tab_id"], "running")
    # Recorded before the rename, so the tab is recognized by either label.
    write_meta(path, meta)
    label = short(args.name, 30) if meta["tab_status"] else f"⧖ {short(args.name, 30)}"
    herdr("tab", "rename", meta["tab_id"], label, check=False)
    meta["client_footer"] = register_job_metadata(meta)
    write_meta(path, meta)
    return meta


def launch_started_job(meta):
    # `pane run` types into the tab's interactive shell; see HISTORY_IGNORE.
    try:
        launch_job_executor(meta, meta["id"])
    finally:
        # The launch is through, whether `pane run` answered or not: a job
        # whose `pane run` failed stays pending until its tab is closed (the
        # command may have been typed although the reply was lost).
        write_atomic(STATE / meta["id"] / LAUNCHED, "launched\n")
    update_owner_token(meta["owner_pane"])
    reconcile_tabs()
    print(meta["id"])


def notify(meta, code):
    """Desktop notification through herdr's own delivery settings. `--pane`
    makes a click focus the job tab, or its workspace once the tab is closed;
    herdr builds without `notification.show_for_pane` get a plain one."""
    when = meta.get("notify", "always")
    if when == "never" or (when == "failure" and code == 0):
        return
    title = f"✓ {meta['name']}" if code == 0 else f"✗ {code} {meta['name']}"
    cmd = ["notification", "show", short(title, 80), "--sound", "done" if code == 0 else "request"]
    body = meta.get("why") or meta.get("origin")
    if body:
        cmd += ["--body", short(body, 240)]
    try:
        herdr(*cmd, "--pane", meta["pane_id"])
    except SystemExit:
        herdr(*cmd, check=False)


class Footer:
    """A status line pinned to the pane's last row: the command's output
    scrolls in the rows above it (a DECSTBM scroll region). herdr with
    vertical tabs shows no tab bar, so this row is the job tab's title:
    ` ← ` in its first three columns goes back to the agent's tab and ` × `
    in its last three closes the job tab (herdr handles those clicks)."""

    def __init__(self, meta):
        self.meta = meta
        self.state = "⧖"
        self.rows = None

    def text(self):
        parts = []
        if self.meta.get("why"):
            parts.append(self.meta["why"])
        parts.append(self.meta.get("origin", ""))
        parts.append(f"herdr-job {self.meta['id']}")
        return " · ".join(p for p in parts if p)

    def size(self):
        try:
            return os.get_terminal_size(sys.stdout.fileno())
        except OSError:
            return None

    @staticmethod
    def clip(text, cells):
        # Conservative cell accounting: joined emoji may occupy fewer cells,
        # but never let user-provided text wrap or inject terminal controls.
        result = []
        used = 0
        for char in " ".join(str(text).split()):
            category = unicodedata.category(char)
            if category.startswith("C"):
                continue
            width = 0 if category.startswith("M") else (
                2 if unicodedata.east_asian_width(char) in ("W", "F") else 1
            )
            if used + width > cells:
                break
            if width == 0 and not result:
                continue
            result.append(char)
            used += width
        return "".join(result), used

    def draw(self, cols):
        # No reverse video or background: it turns into a black bar on light
        # themes. The state is bold in a palette colour, which themes adapt.
        colour = {"⧖": 35, "✓": 32}.get(self.state[:1], 31)
        if cols < 6:
            return
        remaining = cols - 6
        state, used = self.clip(self.state, remaining)
        remaining -= used
        name, used = self.clip(" " + self.meta["name"], max(remaining - 4, 0))
        if name:
            name = " " + name
            used += 1
        remaining -= used
        rest, used = self.clip("· " + self.text(), max(remaining - 1, 0))
        if rest:
            rest = " " + rest
            used += 1
        gap = " " * (remaining - used)
        sys.stdout.write(
            f"\x1b7\x1b[{self.rows};1H\x1b[2K\x1b[2m ← \x1b[0m"
            f"\x1b[1;{colour}m{state}\x1b[0m\x1b[1m{name}\x1b[0m"
            f"\x1b[2m{rest}\x1b[0m{gap}\x1b[2m × \x1b[0m\x1b8"
        )
        sys.stdout.flush()
        self.drawn_rows = self.rows

    def start(self):
        size = self.size()
        if not size or size.lines < 4:
            return
        rows, cols = size.lines, size.columns
        self.rows = rows
        # Start the region at row 1 so output enters terminal scrollback.
        sys.stdout.write(f"\x1b[H\x1b[2J\x1b[1;{rows - 1}r\x1b[1;1H")
        self.draw(cols)

    def resize(self):
        """SIGWINCH: the region follows the new height; the footer stays on
        the last row."""
        size = self.size()
        if not size or size.lines < 4:
            return
        rows, cols = size.lines, size.columns
        self.rows = rows
        # On growth the old footer becomes an output row. Clear it before
        # expanding the region, without disturbing the output cursor.
        old_rows = getattr(self, "drawn_rows", None)
        clear = f"\x1b[{old_rows};1H\x1b[2K" if old_rows and old_rows < rows else ""
        # DECSTBM homes the cursor; keep the command's output position.
        sys.stdout.write(f"\x1b7{clear}\x1b[1;{rows - 1}r\x1b8")
        self.draw(cols)

    def finish(self, code):
        self.state = "✓" if code == 0 else f"! exit {code}"
        size = self.size()
        if not size or size.lines < 4:
            return
        self.rows = size.lines
        self.draw(size.columns)

    def release(self):
        """Leave margins in place; a shell or application may reset them
        or overwrite the footer after the executor returns."""
        sys.stdout.flush()


def launch_job_executor(meta, job_id):
    """A rejected launch must not leave client chrome on an unused shell tab."""
    try:
        herdr("pane", "run", meta["pane_id"], f" {shlex.quote(str(SELF))} _exec {job_id}")
    except SystemExit:
        if meta.get("client_footer"):
            herdr_ok("tab", "job-metadata", meta["tab_id"], "null")
        raise


def register_job_metadata(meta):
    """Only the new method's explicit success disables legacy PTY chrome."""
    job = {key: meta.get(key) for key in ("id", "name", "why", "origin", "owner_pane")}
    # Normalize display fields only; runtime identifiers and saved metadata stay
    # unchanged. Enforce the API byte limit too, including zero-width marks.
    for key in ("name", "why", "origin"):
        if job[key] is not None:
            job[key] = Footer.clip(job[key], 1000)[0].encode("utf-8")[:4096].decode("utf-8", errors="ignore")
    job["name"] = job["name"] or "Job"
    return herdr_ok("tab", "job-metadata", meta["tab_id"], json.dumps(job))


# A job is idle when it printed nothing and used under 2% of one core for 5 minutes.
IDLE_WINDOW_S = 300
IDLE_CPU_FRACTION = 0.02
SAMPLE_INTERVAL_S = 15
# Idle is reported again now and then, so a restarted server learns it.
IDLE_RESEND_SAMPLES = 20


def parse_cputime(text):
    """Seconds in `ps`'s cputime: [[dd-]hh:]mm:ss[.cc]."""
    days = 0
    if "-" in text:
        day_text, text = text.split("-", 1)
        days = int(day_text)
    seconds = 0.0
    for part in text.split(":"):
        seconds = seconds * 60 + float(part)
    return days * 86400 + seconds


def tree_cpu_seconds(ps_output, root_pid):
    """CPU seconds used by `root_pid` and its descendants; `ps_output` has
    `pid ppid cputime` per line. None when the root is gone."""
    children = collections.defaultdict(list)
    cpu = {}
    for line in ps_output.splitlines():
        fields = line.split()
        if len(fields) != 3:
            continue
        try:
            pid, ppid, seconds = int(fields[0]), int(fields[1]), parse_cputime(fields[2])
        except ValueError:
            continue
        children[ppid].append(pid)
        cpu[pid] = seconds
    if root_pid not in cpu:
        return None
    total, stack, seen = 0.0, [root_pid], set()
    while stack:
        pid = stack.pop()
        if pid in seen:
            continue
        seen.add(pid)
        total += cpu.get(pid, 0.0)
        stack.extend(children.get(pid, ()))
    return total


def job_is_idle(samples, last_output, now):
    """Whether the job did nothing for the whole window: `samples` is a list of
    (time, cpu seconds), oldest first; `last_output` the time of its last byte."""
    if now - last_output < IDLE_WINDOW_S:
        return False
    recent = [s for s in samples if now - s[0] <= IDLE_WINDOW_S + SAMPLE_INTERVAL_S]
    if len(recent) < 2 or recent[-1][0] - recent[0][0] < IDLE_WINDOW_S - SAMPLE_INTERVAL_S:
        return False
    elapsed = recent[-1][0] - recent[0][0]
    return (recent[-1][1] - recent[0][1]) / elapsed < IDLE_CPU_FRACTION


def sample_tree_cpu(root_pid):
    try:
        out = subprocess.run(
            ["ps", "-axo", "pid=,ppid=,cputime="], capture_output=True, text=True, timeout=10
        ).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    return tree_cpu_seconds(out, root_pid)


def watch_activity(proc, meta, last_output):
    """Reports to herdr when the job turns idle and when it works again, so
    the sidebar does not show a stalled job as working. `last_output` is a
    one-item list holding the time of the last byte."""
    samples = []
    reported = False
    since_report = 0
    while proc.poll() is None:
        time.sleep(SAMPLE_INTERVAL_S)
        now = time.monotonic()
        cpu = sample_tree_cpu(proc.pid)
        if cpu is None:
            continue
        samples.append((now, cpu))
        samples[:] = [s for s in samples if now - s[0] <= IDLE_WINDOW_S + 2 * SAMPLE_INTERVAL_S]
        # A job whose command waits on another (`herdr-job wait`, `wait-agent`,
        # `watch`) is as alive as its target: silence is what waiting looks like.
        idle = job_is_idle(samples, last_output[0], now) and not job_waits(meta["id"])
        since_report += 1
        if idle != reported or (idle and since_report >= IDLE_RESEND_SAMPLES):
            args = ["tab", "status", meta["tab_id"], "running"] + (["--activity", "idle"] if idle else [])
            herdr_ok(*args)
            reported = idle
            since_report = 0


def keep_awake():
    """Keeps a Mac from idle sleep while this executor lives (its slot wait and
    the command): an unattended build otherwise stops when the display is off,
    since the agent's own inhibitor is not held while a tool call blocks, or
    has gaps. `caffeinate -w` exits with this process, however it ends; its own
    session keeps it out of the job's process group. HERDR_JOB_KEEP_AWAKE=0
    turns it off. Lid-close sleep is not prevented."""
    if sys.platform != "darwin" or os.environ.get("HERDR_JOB_KEEP_AWAKE") == "0":
        return
    try:
        subprocess.Popen(["caffeinate", "-i", "-w", str(os.getpid())],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def cmd_exec(args):
    """Runs inside the job's own pane: stream output to the terminal and the log."""
    path = job_dir(args.id)
    meta = read_meta(path)
    lock = os.open(path / "lock", os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        meta = read_meta(path)  # another executor may have run it before we locked
    except BlockingIOError:
        meta["started"] = True
    # Never run a job twice: after a server restart the relaunch plugin replays
    # the command line typed into this pane, which is `herdr-job _exec <id>`.
    # An `exit` before the start: the launch was given up (`resolve_launch`).
    if "started" in meta or (path / "exit").exists():
        print(f"herdr-job {meta['id']} already ran; not running it again", file=sys.stderr)
        sys.exit(1)
    # The lock stays held until this process exits, and the command inherits
    # it (`pass_fds` below): `status` probes it, so the job is running while
    # anything of it lives, even after this executor died.
    meta["pid"] = os.getpid()
    meta["started"] = time.time()
    write_meta(path, meta)
    keep_awake()
    footer = Footer(meta)
    if not meta.get("client_footer"):
        footer.start()
    print(f"$ {meta['command']}\n", flush=True)
    code = EXIT_LOST
    command = meta["command"]
    slot = []  # the open slot files: closing them, or dropping the last reference, frees the slot
    if meta.get("slot"):
        def waiting(text):
            print(f"herdr-job: {text}", flush=True)
            if meta.get("tab_status"):
                herdr_ok("tab", "status", meta["tab_id"], "running", "--activity", "idle")

        # Held until this process exits; taken here so the tab shows the wait.
        try:
            slot = take_slot(meta["name"], meta["slot"] == "exclusive", meta["id"], waiting)
            if slot and meta.get("tab_status"):
                herdr_ok("tab", "status", meta["tab_id"], "running")
        except SystemExit as err:
            # Fail like the command would, so the reason reaches the log and `wait`.
            command = f"echo {shlex.quote(str(err))} >&2; exit 1"
    # The name labels what the job builds (herdr's build.rs shows it for a
    # release build with uncommitted changes).
    env = dict(os.environ, HERDR_JOB_ID=meta["id"], HERDR_JOB_NAME=meta["name"])
    env.pop("HISTORY_IGNORE", None)
    try:
        # The job has no controlling terminal (its own session, output piped to
        # the log), so /dev/tty fails; this lets it show progress in the tab
        # without putting it in the log that `wait` streams.
        env["HERDR_JOB_TTY"] = os.ttyname(sys.stdout.fileno())
    except OSError:
        pass
    with open(path / "log", "ab", buffering=0) as log:
        # The command and its children keep the job and slot locks: if this
        # executor dies first, the slot is not handed to another build while
        # the command still writes to the same target/.
        proc = subprocess.Popen(
            ["/bin/sh", "-c", command],
            cwd=meta["cwd"],
            env=env,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            start_new_session=True,
            pass_fds=(lock, *(handle.fileno() for handle in slot)),
        )

        def forward(signum, _frame):
            # Once reaped, the job's process group id may belong to another process.
            if proc.returncode is not None:
                return
            try:
                os.killpg(proc.pid, signum)
            except ProcessLookupError:
                pass

        for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(sig, forward)
        if not meta.get("client_footer"):
            signal.signal(signal.SIGWINCH, lambda *_: footer.resize())
        assert proc.stdout is not None
        last_output = [time.monotonic()]
        if meta.get("tab_status") and meta.get("tab_id"):
            threading.Thread(target=watch_activity, args=(proc, meta, last_output), daemon=True).start()
        for chunk in iter(lambda: proc.stdout.read1(65536), b""):
            last_output[0] = time.monotonic()
            sys.stdout.buffer.write(chunk)
            sys.stdout.buffer.flush()
            log.write(chunk)
        proc.stdout.close()
        code = proc.wait()
        if code < 0:
            code = 128 - code
    meta["ended"] = time.time()
    write_meta(path, meta)
    for handle in slot:
        handle.close()
    write_atomic(path / "exit", f"{code}\n")
    if code != 0:
        record_failure(job_owner(meta), meta["name"])
    # The footer first: the herdr calls below take a moment, and the tab
    # label should not be ahead of the job's own status line.
    if not meta.get("client_footer"):
        footer.finish(code)
    if meta.get("tab_status"):
        set_final_tab_status(meta, code)
    else:
        mark = "✓" if code == 0 else "✗"
        herdr("tab", "rename", meta["tab_id"], f"{mark} {short(meta['name'], 30)}", check=False)
    if code != 0:
        # Keep at most the allowed number of this owner's failed tabs open now,
        # not only at the next launch.
        try:
            tabs = {tab["tab_id"]: tab for tab in list_tabs()}
            prune_failed_tabs(job_owner(meta), tabs, job_tab_counts(tabs)[1])
        except (SystemExit, ValueError, KeyError):
            pass
    update_owner_token(meta.get("owner_pane"))
    notify(meta, code)
    print(f"\nherdr-job {meta['id']}: exit {code}", flush=True)
    if code == 0 and not meta.get("keep"):
        # The log stays in the state dir and the sidebar keeps ✓; the tab is noise now.
        print(f"closing this tab in {CLOSE_OK_AFTER_S} s (herdr-job run --keep leaves it open)", flush=True)
        time.sleep(CLOSE_OK_AFTER_S)
        close_job_tab(meta)
    if not meta.get("client_footer"):
        footer.release()
    sys.exit(code)


ANSI_SEQUENCE = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\x1b[()][0-9A-B]")
FAILURE_TAIL_LINES = 40
FAILURE_TAIL_BYTES = 8192


def log_tail(log_path):
    """The last lines of a job's log, without terminal escapes, for the
    report of a failure: bounded, so a noisy build cannot flood the caller."""
    try:
        with open(log_path, "rb") as log:
            log.seek(0, os.SEEK_END)
            log.seek(max(0, log.tell() - 4 * FAILURE_TAIL_BYTES))
            data = log.read()
    except OSError:
        return ""
    text = ANSI_SEQUENCE.sub("", data.decode("utf-8", "replace")).replace("\r", "")
    lines = [line.rstrip() for line in text.split("\n")]
    while lines and not lines[-1]:
        lines.pop()
    tail = "\n".join(lines[-FAILURE_TAIL_LINES:])
    return tail[-FAILURE_TAIL_BYTES:]


def process_identity(pid):
    """The command line and start time of a live process, or None.

    The start time tells the process apart from a later one that reuses its
    pid between `watch` and the job starting to wait."""
    out = subprocess.run(["ps", "-o", "lstart=,command=", "-p", str(pid)],
                         capture_output=True, text=True).stdout.strip()
    if not out:
        return None
    # `lstart` is a fixed five-word date: "Tue Oct  6 12:19:01 2026".
    parts = out.split()
    return " ".join(parts[:5]), " ".join(parts[5:])


def wait_for_exit(pid):
    """Block until the process exits, on its exit event where the OS has one."""
    if hasattr(os, "pidfd_open"):  # Linux
        import select
        try:
            fd = os.pidfd_open(pid)
        except ProcessLookupError:
            return
        select.select([fd], [], [])
        os.close(fd)
        return
    import select
    if hasattr(select, "kqueue"):  # macOS, BSD
        kq = select.kqueue()
        event = select.kevent(pid, select.KQ_FILTER_PROC, select.KQ_EV_ADD | select.KQ_EV_ONESHOT,
                              select.KQ_NOTE_EXIT)
        try:
            kq.control([event], 1, None)
        except ProcessLookupError:
            pass
        kq.close()
        return
    # No exit event for a process that is not our child: poll it (external
    # polling, once a second is enough for work that takes minutes).
    while True:
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return
        except PermissionError:
            pass
        time.sleep(1)


def cmd_watch_pid(args):
    with wait_edge("pid", target_pid=args.pid):
        watch_pid(args)


def watch_pid(args):
    identity = process_identity(args.pid)
    if identity is None or identity[0] != args.started:
        print(f"herdr-job: pid {args.pid} is gone already (or now belongs to another process)")
        return
    print(f"waiting for pid {args.pid}: {identity[1]}")
    wait_for_exit(args.pid)
    # Its exit status belongs to its own parent; this job only saw it end.
    print(f"pid {args.pid} exited; its exit status is unknown to herdr-job")


def cmd_watch(args):
    identity = process_identity(args.pid)
    if identity is None:
        raise SystemExit(f"herdr-job: no process with pid {args.pid}")
    started, command = identity
    args.name = args.name or f"wait: {short(command, 40)}"
    args.command = [str(SELF), "_watch-pid", str(args.pid), started]
    args.keep, args.cwd = False, None
    args.slot = args.exclusive = False
    cmd_run(args)


# A wait records what it waits on, so the sidebar can show the waiting pane
# busy while its target runs (`herdr-bg-badge`, `_waits`) and a job that only
# waits is never marked idle (`watch_activity`). One file per wait under
# `waits/`, published atomically and flocked by the waiting process for its
# whole life: the kernel drops the lock however the wait ends, so an unlocked
# record is a dead wait's, whatever its age.
WAITS = STATE / "waits"


@contextlib.contextmanager
def wait_edge(kind, **target):
    """Records a wait of `kind` (`job`, `agent`, `pid`) on `target` while
    the block runs: the waiting pane (HERDR_PANE_ID), the job it runs in
    (HERDR_JOB_ID, when the wait is itself a job's command) and the start
    time. A record that cannot be written only loses the display."""
    edge = {"kind": kind, "waiter_pane": os.environ.get("HERDR_PANE_ID"),
            "waiter_job": os.environ.get("HERDR_JOB_ID"), "pid": os.getpid(),
            "started": time.time(), **target}
    fd = record = None
    try:
        WAITS.mkdir(parents=True, exist_ok=True, mode=0o700)
        fd, tmp = tempfile.mkstemp(prefix=".edge.", suffix=".tmp", dir=WAITS)
        try:
            os.write(fd, json.dumps(edge, ensure_ascii=False).encode())
            # Locked before it is published: a reader never sees it unlocked.
            fcntl.flock(fd, fcntl.LOCK_EX)
            record = WAITS / f"{os.getpid()}-{secrets.token_hex(3)}.json"
            os.replace(tmp, record)
        except OSError:
            with contextlib.suppress(OSError):
                os.unlink(tmp)
            raise
    except OSError:
        if fd is not None:
            os.close(fd)
        fd = record = None
    try:
        yield
    finally:
        if record is not None:
            with contextlib.suppress(OSError):
                record.unlink()
        if fd is not None:
            os.close(fd)


def live_edges():
    """The records of the waits that still run; a dead wait's record is removed."""
    if not WAITS.is_dir():
        return []
    edges = []
    for record in sorted(WAITS.glob("*.json")):
        try:
            fd = os.open(record, os.O_RDONLY)
        except OSError:
            continue  # its wait just ended
        try:
            try:
                fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
            except BlockingIOError:
                with contextlib.suppress(ValueError, OSError):
                    edges.append(json.loads(record.read_text()))
                continue
            with contextlib.suppress(OSError):
                record.unlink()
        finally:
            os.close(fd)
    return edges


def job_waits(job_id):
    """Whether the job's command is waiting on something now."""
    return any(edge.get("waiter_job") == job_id for edge in live_edges())


def waits_of_pane(pane):
    """The `herdr-job wait`s the pane runs: `edges`, how many run, and `waits`,
    one per job, each with whether its job still runs and whether the pane's
    own job counts show that job already (the pane started it, or its tab is,
    or nests under, the pane's tab)."""
    edges = [edge for edge in live_edges() if edge.get("kind") == "job" and edge.get("waiter_pane") == pane]
    if not edges:
        return {"edges": 0, "waits": []}
    try:
        tabs = {tab["tab_id"]: tab for tab in list_tabs()}
    except (SystemExit, ValueError, KeyError, TypeError):
        tabs = None
    try:
        waiter_tab = json.loads(herdr("pane", "get", pane, check=False) or "{}")["result"]["pane"].get("tab_id")
    except (KeyError, TypeError, ValueError, AttributeError):
        waiter_tab = None
    waits = {}
    for edge in edges:
        job_id = str(edge.get("job_id") or "")
        path = STATE / job_id
        if not job_id or job_id in waits or not (path / "meta.json").is_file():
            continue
        meta = read_meta(path)
        running = active(status(path, meta, tabs)[0])
        job_tab = meta.get("tab_id")
        parent_tab = ((tabs or {}).get(job_tab) or {}).get("parent_tab_id")
        local = meta.get("owner_pane") == pane or (waiter_tab is not None and waiter_tab in (job_tab, parent_tab))
        waits[job_id] = {"job_id": job_id, "job_name": meta.get("name"), "job_tab": job_tab,
                         "started": edge.get("started"), "running": running, "local": local}
    return {"edges": len(edges), "waits": list(waits.values())}


def cmd_waits(args):
    print(json.dumps(waits_of_pane(args.pane), ensure_ascii=False))


def cmd_wait(args):
    """Waits for a job and exits with its code. By default it prints a line
    to say what it waits for, nothing while the job runs, and the final line;
    a failure adds the tail of the log. `--stream` follows the whole log as it
    grows (the old behaviour), `--quiet` prints only the final line."""
    path = job_dir(args.id)
    meta = read_meta(path)
    with wait_edge("job", job_id=args.id, job_tab=meta.get("tab_id")):
        wait_for_job(args, path)


def wait_for_job(args, path):
    log_path = path / "log"
    offset = 0
    stream = args.stream or os.environ.get("HERDR_JOB_WAIT_STREAM") == "1"

    def drain():
        nonlocal offset
        if not stream or args.quiet or not log_path.exists():
            return
        with open(log_path, "rb") as log:
            log.seek(offset)
            data = log.read()
        offset += len(data)
        if data:
            sys.stdout.buffer.write(data)
            sys.stdout.buffer.flush()

    if not stream and not args.quiet:
        meta = read_meta(path)
        print(f"herdr-job {args.id} ({meta['name']}): waiting; to look at it: herdr tab focus {meta.get('tab_id')}", flush=True)
    while True:
        drain()
        st, code = status(path)
        if not active(st):
            drain()
            meta = read_meta(path)
            if st == "lost":
                update_owner_token(meta.get("owner_pane"))
            reconcile_tabs()
            if not stream and not args.quiet and st != "ok":
                tail = log_tail(log_path)
                if tail:
                    print(f"--- last lines of the log (all of it: {log_path}) ---\n{tail}\n---", flush=True)
            print(f"\nherdr-job {args.id} ({meta['name']}): {st}, exit {code}", flush=True)
            sys.exit(code)
        time.sleep(2)


# `wait-agent`: one job that waits for an agent and reconnects inside, so a
# server restart or a dropped answer (`EmptyResponse`) never makes the caller
# start a new job (a new tab) per attempt. Designed backoff, 1 s to 30 s.
AGENT_RETRY_FIRST_S = 1
AGENT_RETRY_MAX_S = 30
AGENT_GIVE_UP_S = 15 * 60
# `agent wait` reports an agent that disappeared while it waited as `agent_not_running`.
AGENT_GONE_CODES = {"agent_not_found", "agent_not_running", "pane_not_found", "terminal_not_found"}
# The server is restarting or not reachable yet: `server_unavailable` is a
# live handoff ("server is shutting down") or a request the app could not take.
# Not `protocol_mismatch`: that one does not pass by waiting.
# `server_handed_off`: a live handoff ended the wait; the new server takes it again.
TRANSPORT_CODES = {"server_not_running", "server_unavailable", "server_handed_off"}
# A read the server refuses while the agent works (`agent_not_idle`).
AGENT_BUSY_CODES = {"agent_not_idle"}
# The line a worker ends its final message with. `<sha>`/`<reason>`
# placeholders, as in a quoted task text, do not count.
WORKER_LINE = re.compile(r"^[\s⏺●•]*(WORKER-DONE ([0-9a-f]{7,40})\b.*|WORKER-BLOCKED [^<\s].*)$")
EXIT_AGENT_GONE = 3
EXIT_WORKER_BLOCKED = 4
EXIT_TRANSPORT_GAVE_UP = 5
EXIT_AWAITING_INPUT = 6
EXIT_NEEDS_ATTENTION = 7
EXIT_TRACKING_LOST = 8


def agent_call(*args):
    """Runs a herdr agent command: ("ok", stdout), ("gone", message),
    ("transport", message) for a lost connection, ("busy", message) for a
    read refused while the agent works, or ("error", message). A command that
    prints a result and still exits non-zero (`agent wait-turn` for a turn
    that did not finish) is ("ok", stdout)."""
    try:
        out = subprocess.run([HERDR, *args], capture_output=True, text=True)
    except OSError as err:
        return "transport", str(err)
    if out.returncode == 0:
        return "ok", out.stdout
    for line in reversed(out.stdout.splitlines()):
        try:
            if "result" in json.loads(line):
                return "ok", out.stdout
        except (ValueError, TypeError):
            continue
    text = (out.stderr.strip() or out.stdout.strip())
    for line in reversed(text.splitlines()):
        try:
            code = json.loads(line)["error"]["code"]
        except (ValueError, KeyError, TypeError):
            continue
        if code in AGENT_GONE_CODES:
            return "gone", line
        if code in AGENT_BUSY_CODES:
            return "busy", line
        return ("transport" if code in TRANSPORT_CODES else "error"), line
    # Not a server answer: the socket, an empty answer, a handoff in progress.
    return "transport", text or f"exit {out.returncode}"


def last_result(stdout):
    for line in reversed(stdout.splitlines()):
        try:
            return json.loads(line)["result"]
        except (ValueError, KeyError, TypeError):
            continue
    return {}


def transcript_path(session, agent):
    """The transcript file of an agent session herdr reports (`agent_session`):
    a path, or for Claude a session id under its projects directory."""
    if not session:
        return None
    if session.get("kind") == "path":
        return Path(session["value"])
    if agent == "claude" and session.get("kind") == "id":
        root = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude") / "projects"
        found = sorted(root.glob(f"*/{session['value']}.jsonl"))
        return found[0] if found else None
    return None


def last_assistant_text(path):
    """The text of the last assistant message in a JSONL transcript (Claude's
    `{"type": "assistant", "message": {...}}`, pi's `{"message": {"role":
    "assistant", ...}}`), skipping subagents' messages."""
    last = None
    with open(path, encoding="utf-8", errors="replace") as handle:
        for line in handle:
            try:
                record = json.loads(line)
            except ValueError:
                continue
            if not isinstance(record, dict) or record.get("isSidechain"):
                continue
            message = record.get("message")
            if not isinstance(message, dict):
                continue
            if (message.get("role") or record.get("type")) != "assistant":
                continue
            content = message.get("content")
            if isinstance(content, str):
                text = content
            elif isinstance(content, list):
                text = "\n".join(part.get("text", "") for part in content
                                 if isinstance(part, dict) and part.get("type") == "text")
            else:
                continue
            if text.strip():
                last = text
    return last


def commit_exists(cwd, sha):
    if not cwd:
        return False
    out = subprocess.run(["git", "-C", cwd, "cat-file", "-e", f"{sha}^{{commit}}"],
                         capture_output=True, text=True)
    return out.returncode == 0


def worker_verdict(agent):
    """Reads the worker's transcript once, after its turn finished, and
    classifies its final message: (exit code, verdict)."""
    path = transcript_path(agent.get("agent_session"), agent.get("agent"))
    if path is None or not path.is_file():
        return EXIT_NEEDS_ATTENTION, f"turn finished; no transcript found for {agent.get('agent_session')}"
    text = last_assistant_text(path)
    if not text:
        return EXIT_NEEDS_ATTENTION, f"turn finished; no assistant message in {path}"
    lines = [line.rstrip() for line in text.splitlines() if line.strip()]
    for line in reversed(lines):
        if match := WORKER_LINE.match(line):
            verdict = match.group(1).strip()
            if verdict.startswith("WORKER-BLOCKED"):
                return EXIT_WORKER_BLOCKED, verdict
            cwd = agent.get("foreground_cwd") or agent.get("cwd")
            if not commit_exists(cwd, match.group(2)):
                return EXIT_NEEDS_ATTENTION, f"{verdict} (but {match.group(2)} is not a commit in {cwd})"
            return 0, verdict
    if lines[-1].endswith("?") or agent.get("awaiting_reply"):
        return EXIT_AWAITING_INPUT, f"awaiting input: {short(agent.get('question') or lines[-1], 300)}"
    return EXIT_NEEDS_ATTENTION, f"turn finished without a WORKER line: {short(lines[-1], 300)}"


def call_until_answered(say, *request):
    """One herdr call, repeated only while herdr does not answer (designed
    backoff); returns (kind, text) of the first answer."""
    delay, failing_since = AGENT_RETRY_FIRST_S, None
    while True:
        kind, text = agent_call(*request)
        if kind != "transport":
            return kind, text
        now = time.monotonic()
        failing_since = failing_since or now
        if now - failing_since >= AGENT_GIVE_UP_S:
            say(f"gave up after {int(now - failing_since) // 60} minutes without herdr: {short(text, 200)}")
            sys.exit(EXIT_TRANSPORT_GAVE_UP)
        say(f"herdr did not answer ({short(text, 120)}); retrying in {delay} s")
        time.sleep(delay)
        delay = min(delay * 2, AGENT_RETRY_MAX_S)


# `--until verdict`: what a pane worker's assignment ended with. Its exit
# codes are distinct, and nothing else ends the wait: not a pane state, not a
# bare turn end (the worker's own background job may still run).
EXIT_VERDICT_DONE = 0
EXIT_VERDICT_BLOCKED = EXIT_WORKER_BLOCKED
EXIT_VERDICT_QUESTION = EXIT_AWAITING_INPUT
EXIT_VERDICT_AGENT_EXITED = EXIT_AGENT_GONE
# What `wait-agent --until verdict` learned about an assignment (its pane, its
# prompt text, its transcript), so it goes on after herdr restarts and forgets
# the request. Request ids are unique across server runs.
ASSIGNMENTS = STATE / "assignments"
TOOL_CALL_PARTS = {"tool_use", "toolCall", "tool_call", "server_tool_use"}


def normalize_prompt(text):
    """Whitespace runs collapsed to one space, as herdr stores a prompt's text."""
    return " ".join(str(text).split())


def assignment_file(request):
    return ASSIGNMENTS / (re.sub(r"[^A-Za-z0-9_.-]", "_", request) + ".json")


def load_assignment(request):
    try:
        record = json.loads(assignment_file(request).read_text())
    except (OSError, ValueError):
        return None
    return record if isinstance(record, dict) and record.get("text") else None


def save_assignment(request, record):
    with contextlib.suppress(OSError):
        ASSIGNMENTS.mkdir(parents=True, exist_ok=True, mode=0o700)
        write_atomic(assignment_file(request), json.dumps(record, ensure_ascii=False))


def transcript_records(path):
    """The main session's records of a JSONL transcript (subagents' skipped):
    (role, texts, calls_tool) per record, where texts are its text parts."""
    with open(path, encoding="utf-8", errors="replace") as handle:
        for line in handle:
            try:
                record = json.loads(line)
            except ValueError:
                continue
            if not isinstance(record, dict) or record.get("isSidechain"):
                continue
            message = record.get("message")
            if not isinstance(message, dict):
                continue
            role = message.get("role") or record.get("type")
            content = message.get("content")
            if isinstance(content, str):
                yield role, [content], False
            elif isinstance(content, list):
                parts = [part for part in content if isinstance(part, dict)]
                yield (role, [part.get("text", "") for part in parts if part.get("type") == "text"],
                       any(part.get("type") in TOOL_CALL_PARTS for part in parts))


def worker_line(text):
    """The last WORKER line of a text, as a match, or None."""
    for line in reversed([line.rstrip() for line in (text or "").splitlines() if line.strip()]):
        if match := WORKER_LINE.match(line):
            return match
    return None


def assignment_verdict(path, prompt, turn_over):
    """The WORKER line the assignment produced, as a match: the last one in an
    assistant text after the user message that carries the assignment's
    prompt, where that text ended its turn (no tool call followed it before
    the next user message). The text at the end of the transcript counts only
    when `turn_over` (the agent is not working), since its tool call may not
    be written yet. None while the prompt is not in the transcript yet, so an
    earlier assignment's verdict never counts."""
    prompt = normalize_prompt(prompt)
    if not prompt:
        return None
    verdict = pending = None
    started = False
    for role, texts, calls_tool in transcript_records(path):
        text = "\n".join(texts)
        if role == "user" and prompt in normalize_prompt(text):
            # The last message carrying the prompt starts the assignment.
            verdict = pending = None
            started = True
            continue
        if not started:
            continue
        if role != "assistant":
            verdict = worker_line(pending) or verdict
            pending = None
            continue
        if text.strip():
            pending = text
        if calls_tool:
            pending = None
    if turn_over:
        verdict = worker_line(pending) or verdict
    return verdict


def verdict_exit(say, match, agent):
    """Reports a WORKER line and exits with its code."""
    verdict = match.group(1).strip()
    if verdict.startswith("WORKER-BLOCKED"):
        say(verdict)
        sys.exit(EXIT_VERDICT_BLOCKED)
    cwd = agent.get("foreground_cwd") or agent.get("cwd")
    if not commit_exists(cwd, match.group(2)):
        say(f"{verdict} (but {match.group(2)} is not a commit in {cwd})")
        sys.exit(EXIT_NEEDS_ATTENTION)
    say(verdict)
    sys.exit(EXIT_VERDICT_DONE)


def resolve_assignment(say, args):
    """The assignment's pane and prompt text: from herdr while it follows the
    request (recorded for later), else from the record of an earlier wait."""
    kind, text = call_until_answered(say, "agent", "prompt-status", args.request)
    if kind == "ok":
        result = last_result(text)
        prompt = result.get("text")
        if not prompt:
            say("herdr does not report the prompt's text (an older herdr?); cannot scope the verdict")
            sys.exit(2)
        saved = load_assignment(args.request) or {}
        record = {"pane": result.get("pane_id") or args.pane, "text": prompt,
                  "transcript": saved.get("transcript"), "cwd": saved.get("cwd")}
        save_assignment(args.request, record)
        return record
    record = load_assignment(args.request)
    if record:
        say(f"herdr no longer follows request {args.request} (did it restart?); going on from the transcript")
        return record
    if "prompt_request_not_found" in text:
        say(f"tracking lost: herdr does not know request {args.request} and no earlier wait recorded it")
        sys.exit(EXIT_TRACKING_LOST)
    say(f"reading request {args.request} failed: {short(text, 200)}")
    sys.exit(2)


def wait_for_verdict(say, args):
    """Waits until the assignment of prompt request `args.request` produced a
    WORKER-DONE/WORKER-BLOCKED line or the worker asks something. Each round
    reads the agent, then its transcript, then waits for the agent's next
    state change after the `state_change_seq` it read (`agent wait-change`,
    an event, no timer), so a change between the read and the wait is never
    missed and a verdict already written ends the wait at once. When herdr
    restarts or hands off, the next round reads everything again."""
    record = resolve_assignment(say, args)
    pane = record["pane"]
    say(f"waiting for the verdict of prompt request {args.request}")
    while True:
        kind, text = call_until_answered(say, "agent", "get", pane)
        if kind == "gone":
            path = record.get("transcript")
            match = path and Path(path).is_file() and assignment_verdict(Path(path), record["text"], True)
            if match:
                verdict_exit(say, match, {"cwd": record.get("cwd")})
            say(f"the agent exited without a verdict: {short(text, 200)}")
            sys.exit(EXIT_VERDICT_AGENT_EXITED)
        if kind != "ok":
            say(f"reading the agent failed: {short(text, 200)}")
            sys.exit(2)
        agent = last_result(text).get("agent") or {}
        path = transcript_path(agent.get("agent_session"), agent.get("agent"))
        seen = {"transcript": str(path) if path else record.get("transcript"),
                "cwd": agent.get("foreground_cwd") or agent.get("cwd") or record.get("cwd")}
        if any(record.get(key) != value for key, value in seen.items()):
            record.update(seen)
            save_assignment(args.request, record)
        if path is not None and path.is_file():
            turn_over = agent.get("agent_status") != "working"
            if match := assignment_verdict(path, record["text"], turn_over):
                verdict_exit(say, match, agent)
        if agent.get("agent_status") == "blocked" or agent.get("awaiting_reply"):
            say(f"the worker asks: {short(agent.get('question') or 'a dialog (read the pane)', 300)}")
            sys.exit(EXIT_VERDICT_QUESTION)
        seq = str(agent.get("state_change_seq", 0))
        kind, text = call_until_answered(say, "agent", "wait-change", pane, "--after", seq)
        if kind not in ("ok", "gone"):
            say(f"waiting for the agent failed: {short(text, 200)}")
            sys.exit(2)


def worker_tab(pane):
    """Whether the pane's tab has the worker role; False when herdr cannot tell."""
    try:
        tab_id = (last_result(herdr("pane", "get", pane, check=False)).get("pane") or {}).get("tab_id")
        return bool(tab_id) and any(tab.get("tab_id") == tab_id and tab.get("role") == "worker"
                                    for tab in list_tabs())
    except (SystemExit, ValueError, KeyError, TypeError):
        return False


def cmd_wait_agent(args):
    """Waits for one agent: with `--request ID --until verdict` until that
    assignment produced a WORKER line or the worker asks; with `--request`
    alone until the turn of that prompt request ends (`herdr agent
    wait-turn`, an event, no timer), then reads the worker's transcript once
    for its verdict; otherwise until it reaches a state (`herdr agent wait`).
    Transport errors are retried here with backoff; an agent that is gone
    ends the wait."""
    verdict = "verdict" in args.until
    if verdict and (not args.request or len(args.until) > 1):
        raise SystemExit("herdr-job wait-agent: --until verdict needs --request ID and no other --until")
    if not args.request and worker_tab(args.pane):
        raise SystemExit(
            f"herdr-job wait-agent: {args.pane} is a worker's pane; a state or a turn end is not its verdict. "
            f"Wait with `herdr-job wait-agent {args.pane} --request <the prompt's request_id> --until verdict`.")
    with wait_edge("agent", target_pane=args.pane, request=args.request):
        if verdict:
            wait_for_verdict(lambda text: print(f"herdr-job wait-agent {args.pane}: {text}", flush=True), args)
        wait_for_agent(args)


def wait_for_agent(args):
    say = lambda text: print(f"herdr-job wait-agent {args.pane}: {text}", flush=True)
    if args.request:
        say(f"waiting for the turn of prompt request {args.request}")
        kind, text = call_until_answered(say, "agent", "wait-turn", args.request)
    else:
        say(f"waiting for {', '.join(args.until) or 'idle, done or blocked'}")
        kind, text = call_until_answered(
            say, "agent", "wait", args.pane, *[flag for state in args.until for flag in ("--until", state)])
    if kind == "gone":
        say(f"the agent is gone: {short(text, 200)}")
        sys.exit(EXIT_AGENT_GONE)
    if kind != "ok":
        say(f"failed: {short(text, 200)}")
        sys.exit(2)
    if not args.request:
        say(f"reached: {short(text.strip(), 300)}")
        return
    result = last_result(text)
    reason = result.get("reason")
    if reason == "unknown_request":
        say(f"tracking lost: herdr does not know request {args.request} (did its server restart?)")
        sys.exit(EXIT_TRACKING_LOST)
    if reason == "exited":
        say("the agent exited before its turn ended")
        sys.exit(EXIT_AGENT_GONE)
    if reason == "failed":
        say(f"the turn failed: {short(result.get('error') or 'no error given', 300)}")
        sys.exit(EXIT_NEEDS_ATTENTION)
    if reason != "finished":
        say(f"the turn ended: {reason or short(text.strip(), 200)}")
        sys.exit(EXIT_NEEDS_ATTENTION)
    kind, text = call_until_answered(say, "agent", "get", args.pane)
    if kind != "ok":
        say(f"turn finished; reading the agent failed: {short(text, 200)}")
        sys.exit(EXIT_AGENT_GONE if kind == "gone" else 2)
    code, verdict = worker_verdict(last_result(text).get("agent") or {})
    say(verdict)
    sys.exit(code)


def cmd_list(_args):
    reconcile_tabs()
    jobs = all_jobs()
    if not jobs:
        print("no jobs")
        return
    try:
        tabs = {tab["tab_id"]: tab for tab in list_tabs()}
    except (SystemExit, ValueError, KeyError):
        tabs = None
    for path, meta in jobs:
        st, code = status(path, meta, tabs)
        end = meta.get("ended") or time.time()
        minutes = int((end - meta.get("started", meta["created"])) // 60)
        state = st if code is None else f"{st} ({code})"
        print(f"{meta['id']}  {state:<12} {minutes:>4}m  {meta['name']}  [{meta.get('tab_id') or 'no tab'}]")


LINK_JOB = re.compile(r"herdr-job://(\d{8}-\d{6}-[0-9a-f]{4})")


def cmd_open(args):
    """Focuses a job's tab. With `--from-click` the id comes from the link that
    was clicked (`herdr-job://<id>`, the plugin's link handler)."""
    if args.from_click:
        match = LINK_JOB.fullmatch(os.environ.get("HERDR_PLUGIN_CLICKED_URL", ""))
        if not match:
            raise SystemExit("herdr-job: the clicked link is not a job link")
        job_id = match.group(1)
    else:
        job_id = args.id or ""
    if not re.fullmatch(r"\d{8}-\d{6}-[0-9a-f]{4}", job_id) or not job_dir(job_id).is_dir():
        raise SystemExit(f"herdr-job: no such job {job_id!r}")
    tab_id = read_meta(job_dir(job_id)).get("tab_id")
    # One lookup of the tab itself (a click should feel instant, and the list
    # of all jobs grows): the tab must still carry this job's metadata, so a
    # closed tab, or a tab id another job now holds, is not focused.
    try:
        tab = json.loads(herdr("tab", "get", tab_id, check=False) or "{}")["result"]["tab"]
    except (KeyError, TypeError, ValueError):
        tab = {}
    if (tab.get("job") or {}).get("id") != job_id:
        raise SystemExit(f"herdr-job: the tab of {job_id} is gone")
    herdr("tab", "focus", tab_id)


def cmd_log(args):
    print(job_dir(args.id) / "log")


def cmd_clean(args):
    owners = set()
    here = os.environ.get("HERDR_PANE_ID")
    tabs = {tab["tab_id"]: tab for tab in list_tabs()}
    mine = [(path, meta) for path, meta in all_jobs() if args.all or meta.get("owner_pane") == here]
    # The states first: settling a dead launcher's job may close its tab.
    states = [(path, meta, status(path, meta, tabs)[0]) for path, meta in mine]
    owned = job_tabs(tabs)
    for path, meta, st in states:
        if active(st):
            continue
        # A reused tab id or a renamed tab is not this job's to close.
        tab_id = meta.get("tab_id")
        if tab_id in owned and owned[tab_id][0] == path and not herdr_ok("tab", "close", tab_id):
            print(f"herdr-job: could not close tab {tab_id} of {meta['id']}; keeping the job", file=sys.stderr)
            continue
        owners.add(meta.get("owner_pane"))
        for child in path.iterdir():
            child.unlink()
        path.rmdir()
    for owner in owners:
        update_owner_token(owner)
    reconcile_tabs()


def main():
    os.umask(0o077)  # commands and logs may contain secrets
    parser = argparse.ArgumentParser(prog="herdr-job", description=__doc__.split("\n\n")[0])
    sub = parser.add_subparsers(dest="cmd", required=True)
    run = sub.add_parser("run", help="start a job in its own tab")
    run.add_argument("--name", required=True)
    run.add_argument("--why", help="why the job runs; shown in the job tab's footer")
    run.add_argument("--keep", action="store_true", help="keep the tab open after success")
    run.add_argument(
        "--notify",
        choices=["always", "failure", "never"],
        help="desktop notification when the job ends (default: always when started by hand, never from an agent)",
    )
    run.add_argument("--cwd")
    run.add_argument("--slot", action="store_true", help="wait for a machine-wide slot before running (builds, tests)")
    run.add_argument("--exclusive", action="store_true", help="take every slot, for benchmarks")
    run.add_argument("--key", help="an idempotency key: a run with a key that a job already has prints "
                                    "that job's id instead of starting another")
    run.add_argument("--force", action="store_true",
                     help=f"start even though this name failed {NAME_FAILURES_MAX} times in the last "
                          f"{NAME_FAILURES_WINDOW_S // 60} minutes")
    run.add_argument("command", nargs=argparse.REMAINDER)
    run.set_defaults(func=cmd_run)
    watch = sub.add_parser("watch", help="a job that waits for a process you did not start")
    watch.add_argument("--pid", type=int, required=True)
    watch.add_argument("--name", help="default: `wait:` and the process's command")
    watch.add_argument("--why", help="why you wait; shown in the job tab's footer")
    watch.add_argument("--notify", choices=["always", "failure", "never"])
    watch.set_defaults(func=cmd_watch)
    watch_pid = sub.add_parser("_watch-pid")
    watch_pid.add_argument("pid", type=int)
    watch_pid.add_argument("started")
    watch_pid.set_defaults(func=cmd_watch_pid)
    wait = sub.add_parser("wait", help="wait for a job to end")
    wait.add_argument("id")
    wait.add_argument("--quiet", action="store_true")
    wait.add_argument("--stream", action="store_true", help="follow the whole log as it grows")
    wait.set_defaults(func=cmd_wait)
    waits = sub.add_parser("_waits", help=argparse.SUPPRESS)
    waits.add_argument("--pane", required=True)
    waits.set_defaults(func=cmd_waits)
    wait_agent = sub.add_parser(
        "wait-agent", help="wait for an agent in one job, reconnecting when herdr does not answer",
        description="Exit 0: the state was reached, or WORKER-DONE with a commit that exists; "
                    "3: the agent is gone or exited (with --until verdict: exited without a verdict); "
                    "4: WORKER-BLOCKED; 5: gave up after 15 minutes without herdr; 6: the worker asks "
                    "something (a question or a dialog); 7: needs attention (the turn failed, was "
                    "interrupted, finished without a WORKER line, or WORKER-DONE names no commit); "
                    "8: herdr lost track of the request (with --until verdict: only when no earlier "
                    "wait recorded it); 2: another error. With --until verdict nothing but a WORKER "
                    "line, a question or the agent's exit ends the wait.")
    wait_agent.add_argument("pane")
    wait_agent.add_argument("--until", action="append", default=[],
                            choices=["idle", "working", "blocked", "done", "unknown", "verdict"],
                            help="state to wait for; repeat for more (default: idle, done or blocked); "
                                 "`verdict` with --request: until that assignment's WORKER-DONE/WORKER-BLOCKED "
                                 "line or the worker's question, for pane workers")
    wait_agent.add_argument("--request", metavar="ID",
                            help="end when the turn of this prompt request ends (the request_id that "
                                 "`herdr agent prompt` prints), then report the worker's verdict "
                                 "from its transcript")
    wait_agent.set_defaults(func=cmd_wait_agent)
    sub.add_parser("list", help="list jobs").set_defaults(func=cmd_list)
    open_ = sub.add_parser("open", help="focus a job's tab")
    open_.add_argument("id", nargs="?")
    open_.add_argument("--from-click", action="store_true", help="take the id from the clicked job link")
    open_.set_defaults(func=cmd_open)
    log = sub.add_parser("log", help="print the log path")
    log.add_argument("id")
    log.set_defaults(func=cmd_log)
    clean = sub.add_parser("clean", help="close tabs of this pane's finished jobs")
    clean.add_argument("--all", action="store_true", help="also jobs started from other panes")
    clean.set_defaults(func=cmd_clean)
    slot = sub.add_parser("slot", help="run a command here, under a machine-wide slot")
    slot.add_argument("--exclusive", action="store_true", help="take every slot, for benchmarks")
    slot.add_argument("--name", help="how `slots` and waiting requests name this command")
    slot.add_argument("command", nargs=argparse.REMAINDER)
    slot.set_defaults(func=cmd_slot)
    sub.add_parser("slots", help="show who holds the slots").set_defaults(func=cmd_slots)
    tree = sub.add_parser("clean-tree", help="run a command in a clean tree: HEAD plus only the named paths")
    tree.add_argument("--path", dest="print_path", action="store_true", help="print the clean tree's directory")
    tree.add_argument("--then", metavar="SHELL-COMMAND",
                      help="run this with sh -c in the clean tree after COMMAND succeeds, under the same lock")
    tree.add_argument("rest", nargs=argparse.REMAINDER, metavar="[PATH...] -- COMMAND...")
    tree.set_defaults(func=cmd_clean_tree)
    sub.add_parser("_tab-closed").set_defaults(func=cmd_tab_closed)
    exec_ = sub.add_parser("_exec")
    exec_.add_argument("id")
    exec_.set_defaults(func=cmd_exec)
    args = parser.parse_args()
    if getattr(args, "command", None) and args.command[:1] == ["--"]:
        args.command = args.command[1:]
    args.func(args)


if __name__ == "__main__":
    main()
