#!/usr/bin/env python3
"""Claude Code SessionStart/Stop hook: show the Claude session's peer name as a herdr sidebar token.

Other sessions address this one by the name in ~/.claude/sessions/<pid>.json (e.g. `herdr-ef`),
so the pane reports it as the `$peer` token. SessionStart runs before Claude writes the name, so
a detached child waits for Claude to write it (file events on the sessions directory) and ends
when it reports it or when that Claude process exits; Stop refreshes the token's TTL and picks
up a later /rename. Never fails the hook. The detached child has no terminal, so it writes why it
gave up to GIVE_UPS (under herdr-job's state directory) as well as to stderr.
"""
import json
import os
import runpy
import subprocess
import sys
import time
from pathlib import Path

SESSIONS = Path.home() / ".claude/sessions"
SHELLS = {"sh", "bash", "dash", "zsh"}
TTL_MS = 12 * 60 * 60 * 1000
# delay: a bound on a hung call, not a wait for an event: `report-metadata`
# answers in milliseconds, so one that has not after this long hangs.
REPORT_BOUND_S = 5
GIVE_UPS = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "herdr-job" / "peer-token.log"
HERDR = os.environ.get("HERDR_BIN_PATH", "")
if not os.access(HERDR, os.X_OK):
    HERDR = "herdr"


def session_name(session_id):
    for f in SESSIONS.glob("*.json"):
        try:
            s = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        if s.get("sessionId") == session_id:
            return s.get("name")
    return None


def report(session_id):
    """True when the token was reported, False to retry later."""
    name = session_name(session_id)
    if not name:
        return False
    subprocess.run([HERDR, "pane", "report-metadata", os.environ["HERDR_PANE_ID"], "--source", "claude-peer",
                    "--token", f"peer={name}", "--ttl-ms", str(TTL_MS)],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=REPORT_BOUND_S)
    return True


def claude_pid():
    """The Claude process that ran this hook: the nearest ancestor that is
    not the shell Claude runs hooks with."""
    pid = os.getppid()
    for _ in range(8):  # bounded: a hook runs a few shells deep at most
        out = subprocess.run(["ps", "-o", "ppid=,comm=", "-p", str(pid)],
                             capture_output=True, text=True).stdout.split(None, 1)
        if len(out) != 2:
            return None
        if os.path.basename(out[1].strip()).lstrip("-") not in SHELLS:
            return pid
        pid = int(out[0])
    return None


def give_up(message):
    """Says why the child ends without the name: on stderr, and as a line in
    GIVE_UPS, since the detached child's stderr goes nowhere."""
    line = f"herdr-peer-token: {message}"
    print(line, file=sys.stderr, flush=True)
    try:
        GIVE_UPS.parent.mkdir(parents=True, exist_ok=True)
        with open(GIVE_UPS, "a") as log:
            log.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')} {line}\n")
    except OSError as err:
        print(f"herdr-peer-token: cannot write {GIVE_UPS}: {err}", file=sys.stderr, flush=True)
    return 1


def wait_and_report(session_id, pid):
    """Reports the name once Claude writes it. Waits on file events in the
    sessions directory, no pause; ends without the name, loudly (`give_up`,
    status 1), when Claude process `pid` exits first, the directory cannot
    be watched or reporting the name fails. Returns the exit status."""
    job = runpy.run_path(str(Path(os.path.realpath(__file__)).with_name("herdr-job")))
    try:
        watch = job["make_dir_watch"](SESSIONS, pid=pid)
    except job["WriterExited"]:
        watch = None
    except job["TextSourceError"] as err:
        return give_up(f"cannot watch {SESSIONS}: {err}")
    session_file = SESSIONS / f"{pid}.json"
    watched = None  # (fd, inode) of Claude's session file, whose writes wake the wait too

    def follow_session_file():
        nonlocal watched
        try:
            fd = os.open(session_file, os.O_RDONLY)
        except OSError:
            return  # not there yet: its creation is a directory event
        inode = os.fstat(fd).st_ino
        if watched is not None and watched[1] == inode:
            os.close(fd)
            return
        if watched is not None:
            os.close(watched[0])
        watched = (fd, inode)
        watch.watch_file(fd)

    try:
        # Armed before each look, so a name written in between wakes it.
        while True:
            if watch is None:
                if not report(session_id):
                    raise job["WriterExited"]()
                break
            follow_session_file()
            if report(session_id):
                break
            watch.wait()
    except job["WriterExited"]:
        return give_up(f"Claude (pid {pid}) exited before it named session {session_id}")
    except job["TextSourceError"] as err:
        return give_up(str(err))
    except (OSError, subprocess.TimeoutExpired) as err:
        return give_up(f"stopped before it reported session {session_id}'s name: {err}")
    finally:
        if watch is not None:
            watch.close()
        if watched is not None:
            os.close(watched[0])
    return 0


def main():
    if len(sys.argv) == 4 and sys.argv[1] == "--retry":
        sys.exit(wait_and_report(sys.argv[2], int(sys.argv[3])))
    payload = json.load(sys.stdin)
    session_id = payload.get("session_id")
    if (not session_id or payload.get("agent_id") or not os.environ.get("HERDR_PANE_ID")
            or not os.environ.get("HERDR_SOCKET_PATH")):
        return
    if not report(session_id) and payload.get("hook_event_name") == "SessionStart":
        pid = claude_pid()
        if pid is None:
            return  # the Stop hook reports the name
        # Not Claude's pipes: the hook must end now, and Claude waits for them to close.
        subprocess.Popen([sys.executable, os.path.realpath(__file__), "--retry", session_id, str(pid)],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)


if __name__ == "__main__":
    try:
        main()
    except SystemExit:
        raise
    except Exception:
        pass
