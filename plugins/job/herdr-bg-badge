#!/usr/bin/env python3
"""Claude Code Stop/SubagentStop hook: show running background tasks as a herdr sidebar token.

Reads the hook payload's `background_tasks` (Claude Code 2.1.28x), logs it to
~/.local/state/herdr-bg/payloads.jsonl, and reports `$bg` pane metadata:
the number of running tasks (`2 bg`), or cleared when none run. Tasks that
only wait for a herdr-job are skipped: its `$jobs` token already counts them.
Never fails the hook: all errors are swallowed.
"""
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

LOG = Path.home() / ".local/state/herdr-bg/payloads.jsonl"
LOG_MAX_BYTES = 1_000_000
DONE = {"completed", "failed", "killed", "stopped", "cancelled", "canceled", "error"}
TTL_MS = 12 * 60 * 60 * 1000
JOB_WAIT = re.compile(r"(^|[\s/])herdr-job\s+wait\s")
HERDR = os.environ.get("HERDR_BIN_PATH", "")
if not os.access(HERDR, os.X_OK):
    HERDR = "herdr"


def log(entry):
    os.umask(0o077)  # payloads contain commands
    LOG.parent.mkdir(parents=True, exist_ok=True)
    if LOG.exists() and LOG.stat().st_size > LOG_MAX_BYTES:
        LOG.replace(LOG.with_suffix(".jsonl.old"))
    with LOG.open("a", encoding="utf-8") as f:
        f.write(json.dumps(entry, ensure_ascii=False) + "\n")


def waits_for_job(task):
    return bool(JOB_WAIT.search(str(task.get("command") or "")))


def main():
    payload = json.load(sys.stdin)
    tasks = payload.get("background_tasks")
    log({
        "ts": time.strftime("%Y-%m-%dT%H:%M:%S"),
        "event": payload.get("hook_event_name"),
        "session_id": payload.get("session_id"),
        "agent_id": payload.get("agent_id"),
        "pane": os.environ.get("HERDR_PANE_ID"),
        "background_tasks": tasks,
    })

    pane = os.environ.get("HERDR_PANE_ID")
    if not pane or not os.environ.get("HERDR_SOCKET_PATH") or tasks is None:
        return
    running = [
        t for t in tasks if str(t.get("status", "")).lower() not in DONE and not waits_for_job(t)
    ]
    cmd = [HERDR, "pane", "report-metadata", pane, "--source", "claude-bg"]
    if not running:
        cmd += ["--clear-token", "bg"]
    else:
        cmd += ["--token", f"bg={len(running)} bg", "--ttl-ms", str(TTL_MS)]
    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
