   "expect":{"state":{"step":"verify","status":"running","pending":"verify_integrated"},
             "effects":[{"kind":"verify_integrated"}]}},
  {"input":{"id":"e2","fence":{"tenure_epoch":4,"pane_generation":2},"event":{"kind":"verified","integrated":"i1"}},
   "expect":{"state":{"step":"cherry_pick","integrated":"i1","pending":"cherry_pick","picked":null},
             "effects":[{"kind":"cherry_pick"}]}},
  {"input":{"id":"e3","fence":{"tenure_epoch":4,"pane_generation":2},"event":{"kind":"picked","sha":"p1"}},
   "expect":{"state":{"step":"install","picked":"p1"},"effects":[{"kind":"install"}]}},
  {"input":{"id":"e4","fence":{"tenure_epoch":4,"pane_generation":2},"event":{"kind":"installed"}},
   "expect":{"state":{"step":"todo"},"effects":[{"kind":"todo_edit"}]}},
  {"input":{"id":"e5","fence":{"tenure_epoch":4,"pane_generation":2},"event":{"kind":"edited"}},
   "expect":{"state":{"step":"push","slot_held":true},"effects":[{"kind":"push"}]}},
  {"input":{"id":"e6","fence":{"tenure_epoch":4,"pane_generation":2},"event":{"kind":"push_acked","sha":"t1"}},
   "expect":{"state":{"step":"cleanup","slot_held":false,"pushed":"t1"},
             "effects":[{"kind":"release_slot"},{"kind":"cleanup"}]}},
  {"input":{"id":"e7","fence":{"tenure_epoch":4,"pane_generation":2},"event":{"kind":"cleaned_up"}},
   "expect":{"state":{"step":"done","status":"done","pending":null,"degraded":[]},
             "effects":[{"kind":"emit","event":"done"}]}}]}
